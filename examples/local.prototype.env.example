# vibit local prototype environment template.
# Copy field names into a private local file such as .vibit.local.env.
# Replace every placeholder locally. Do not commit real DSNs, verifier keys,
# access tokens, device credentials, digests, headers, cookies, query strings,
# WebSocket subprotocol values, remote addresses, or transport metadata.

VIBIT_RUNTIME_STORE=postgres
VIBIT_ADDR=:8080

# Placeholder only. Keep a real DSN in private local configuration.
VIBIT_POSTGRES_DSN=postgres://<local-user>:<local-password>@127.0.0.1:5432/<local-db>?sslmode=disable

# Placeholder only. Use local-only key set ids and Base64 key values.
VIBIT_AUTH_VERIFIER_KEY_SET_ID=<local-key-set-id>
VIBIT_AUTH_CREDENTIAL_LOOKUP_KEY=<base64-32-byte-minimum-local-key>
VIBIT_AUTH_CREDENTIAL_VERIFIER_KEY=<base64-32-byte-minimum-local-key>
VIBIT_AUTH_TOKEN_LOOKUP_KEY=<base64-32-byte-minimum-local-key>
VIBIT_AUTH_TOKEN_VERIFIER_KEY=<base64-32-byte-minimum-local-key>

# Optional local posture.
VIBIT_AUTH_ACCESS_TOKEN_TTL=1h
VIBIT_AUTH_TOKEN_AUDIENCE=local-prototype
VIBIT_POSTGRES_MAX_CONNS=4
VIBIT_POSTGRES_MIN_CONNS=0
