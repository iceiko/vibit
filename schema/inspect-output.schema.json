{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibit.dev/schema/inspect-output.schema.json",
  "title": "vibit Inspect Output",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "module"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "module_inspection"
        },
        "project": {
          "const": "vibit"
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "from", "to", "dependency", "guidance"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "boundary_inspection"
        },
        "project": {
          "const": "vibit"
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "contract"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "contract_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "contract": {
          "type": "object",
          "required": ["request", "registry", "source", "module_manifest", "consistency", "guidance"],
          "properties": {
            "request": {
              "type": "object",
              "required": ["module", "type", "normalized_type", "id"]
            },
            "registry": {
              "type": "object",
              "required": ["exists", "path", "entry"]
            },
            "source": {
              "type": "object",
              "required": ["exists", "path", "schema_version", "kind", "module", "status"]
            },
            "module_manifest": {
              "type": "object",
              "required": ["exists", "path", "declares_id", "references_source"]
            },
            "consistency": {
              "type": "object",
              "required": [
                "registered",
                "source_exists",
                "source_under_module",
                "kind_matches",
                "module_matches",
                "id_matches",
                "module_manifest_exists",
                "module_manifest_declares_id",
                "module_manifest_references_source",
                "status"
              ]
            },
            "guidance": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "change"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "change_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "change": {
          "type": "object",
          "required": [
            "change_id",
            "declared_change_id",
            "exists",
            "path",
            "spec",
            "spec_exists",
            "date",
            "type",
            "status",
            "summary",
            "affected_modules",
            "verification",
            "files"
          ],
          "properties": {
            "change_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
            },
            "declared_change_id": {
              "type": ["string", "null"]
            },
            "exists": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "spec": {
              "type": "string"
            },
            "spec_exists": {
              "type": "boolean"
            },
            "date": {
              "type": ["string", "null"]
            },
            "type": {
              "type": ["string", "null"]
            },
            "status": {
              "type": ["string", "null"]
            },
            "summary": {
              "type": ["string", "null"]
            },
            "affected_modules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verification": {
              "type": "object",
              "required": ["required", "status"],
              "properties": {
                "required": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": ["string", "null"]
                }
              }
            },
            "files": {
              "type": "object",
              "required": ["request.md", "spec.yaml", "impact.md", "plan.md", "checklist.md", "verification.md"],
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "catalog", "rule"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "rule_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "rule": {
          "type": "object",
          "required": ["rule_id", "category", "default_severity", "title", "description", "agent_guidance"]
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "catalog", "filter", "count", "rules"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "rules_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "filter": {
          "type": "object"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "category", "default_severity", "title", "description", "agent_guidance"]
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "summary", "memory", "guidance"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "memory_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "summary": {
          "type": "object",
          "required": ["changes", "conversations", "decisions"],
          "properties": {
            "changes": {
              "type": "integer",
              "minimum": 0
            },
            "conversations": {
              "type": "integer",
              "minimum": 0
            },
            "decisions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "memory": {
          "type": "object",
          "required": ["changes", "conversations", "decisions"],
          "properties": {
            "changes": {
              "type": "array"
            },
            "conversations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["conversation_id", "title", "date", "path", "related_changes", "related_artifacts"]
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "decision_id",
                  "title",
                  "status",
                  "date",
                  "path",
                  "related_changes",
                  "related_conversations",
                  "related_artifacts"
                ]
              }
            }
          }
        },
        "guidance": {
          "type": "object",
          "required": ["intake_order", "related_commands"],
          "properties": {
            "intake_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "related_commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "work", "continuation"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "work_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "work": {
          "type": "object",
          "required": ["manifest", "standard", "status", "current_milestone", "summary", "current", "milestones", "work_items"]
        },
        "continuation": {
          "type": "object",
          "required": ["default_step_unit", "one_step", "multi_step", "next_command"]
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "check", "status", "summary", "results"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "check_result"
        },
        "project": {
          "const": "vibit"
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "summary": {
          "type": "object"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "severity", "rule_id", "artifact", "message"],
            "properties": {
              "status": {
                "enum": ["passed", "warning", "failed"]
              },
              "severity": {
                "enum": ["info", "warning", "error"]
              },
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "artifact": {
                "type": ["string", "null"]
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "subchecks": {
          "type": "array",
          "items": {
            "type": ["object", "null"]
          }
        }
      }
    }
  ]
}
