{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibit.dev/schema/inspect-output.schema.json",
  "title": "vibit Inspect Output",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "module"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "module_inspection"
        },
        "project": {
          "const": "vibit"
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "from", "to", "dependency", "guidance"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "boundary_inspection"
        },
        "project": {
          "const": "vibit"
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "catalog", "rule"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "rule_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "rule": {
          "type": "object",
          "required": ["rule_id", "category", "default_severity", "title", "description", "agent_guidance"]
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "catalog", "filter", "count", "rules"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "rules_inspection"
        },
        "project": {
          "const": "vibit"
        },
        "filter": {
          "type": "object"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "category", "default_severity", "title", "description", "agent_guidance"]
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "project", "check", "status", "summary", "results"],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "check_result"
        },
        "project": {
          "const": "vibit"
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "summary": {
          "type": "object"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "severity", "rule_id", "artifact", "message"],
            "properties": {
              "status": {
                "enum": ["passed", "warning", "failed"]
              },
              "severity": {
                "enum": ["info", "warning", "error"]
              },
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "artifact": {
                "type": ["string", "null"]
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "subchecks": {
          "type": "array",
          "items": {
            "type": ["object", "null"]
          }
        }
      }
    }
  ]
}
