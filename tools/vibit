      checkRequiredText(root, file, marker, ruleId, marker);
    }
  }

  const repositoryInterfaceCompleted = workItemHasStatus(root, "W-0136", "completed");
  if (exists(root, "runtime/internal/app/session") && !repositoryInterfaceCompleted) {
    fail("runtime/internal/app/session exists before a session repository implementation work item", {
      rule_id: ruleId,
      artifact: "runtime/internal/app/session",
    });
  } else if (exists(root, "runtime/internal/app/session") && repositoryInterfaceCompleted) {
    ok("runtime/internal/app/session exists after completed W-0136", {
      rule_id: ruleId,
      artifact: "runtime/internal/app/session",
    });
  } else {
    ok("runtime/internal/app/session remains absent for gate-only session repository boundary", {
      rule_id: ruleId,
      artifact: "runtime/internal/app/session",
    });
  }

  const migrationFiles = discoverMigrationFiles(root);
  const unauthorizedSessionMigration = migrationFiles.find((file) => {
    if (path.basename(file) === "000005_create_runtime_sessions.sql") {
      return false;
    }
    const text = readText(path.join(root, file));
    return /\bruntime_sessions\b|\bruntime_session_connections\b/.test(text);
  });
  if (unauthorizedSessionMigration) {
    fail(`${unauthorizedSessionMigration} adds session migration content during session repository boundary`, {
      rule_id: ruleId,
      artifact: unauthorizedSessionMigration,
    });
  } else {
    ok("no extra runtime session migration is added by session repository boundary", {
      rule_id: ruleId,
      artifact: "runtime/migrations/postgres",
    });
  }

  const sourceFiles = goFiles.filter((file) => !file.endsWith("_test.go"));
  const adapterImplementationCompleted = workItemHasStatus(root, "W-0140", "completed");
  const validationImplementationCompleted = workItemHasStatus(root, "W-0144", "completed");
  const sessionCreationImplementationCompleted = workItemHasStatus(root, "W-0148", "completed");
  const forbiddenSourcePatterns = [
    { pattern: /\bruntime_session_connections\b/, label: "runtime_session_connections table usage" },
    { pattern: /\bSessionRepository\b/, label: "session repository implementation" },
    { pattern: /\bNewSessionRepository\b/, label: "session repository constructor" },
    { pattern: /\bCreateRuntimeSession\b|\bGetRuntimeSession\b|\bFindActiveSessionByID\b|\bUpdateRuntimeSessionLastSeen\b|\bMarkRuntimeSessionExpired\b|\bRevokeRuntimeSession\b|\bCleanupRuntimeSessions\b/, label: "runtime session repository behavior" },
    { pattern: /\bSessionValidated\s*=\s*true\b/, label: "validated session identity" },
  ];
  for (const file of sourceFiles) {
    if (repositoryInterfaceCompleted && pathStartsWith(file, "runtime/internal/app/session/")) {
      continue;
    }
    if (adapterImplementationCompleted &&
      (file === "runtime/internal/platform/persistence/postgres/session_repository.go" ||
        file === "runtime/internal/platform/persistence/postgres/runner.go")) {
      continue;
    }
    if (validationImplementationCompleted && isRuntimeSessionValidationImplementationFile(file)) {
      continue;
    }
    if (sessionCreationImplementationCompleted && isSessionCreationCompositionImplementationFile(file)) {
      continue;
    }
    const text = sourceWithoutGoComments(readText(path.join(root, file)));
    const matches = textMatchesAny(text, forbiddenSourcePatterns);
    for (const match of matches) {
      fail(`${file} crosses session repository boundary with ${match.label}`, {
        rule_id: ruleId,
        artifact: file,
      });
    }
  }
  ok("runtime Go source remains free of session repository, adapter, and behavior usage for W-0134", {
    rule_id: ruleId,
    artifact: "runtime",
  });

  const wsFiles = goFiles
    .filter((file) => pathStartsWith(file, "runtime/internal/platform/transport/ws/"))
    .filter((file) => !file.endsWith("_test.go"));
  const forbiddenTransportPatterns = [
    { pattern: /\bAuthorization\b/, label: "Authorization header handling" },
    { pattern: /\bBearer\b/, label: "Bearer token handling" },
    { pattern: /\bSec-WebSocket-Protocol\b/, label: "WebSocket subprotocol auth carrier" },
    { pattern: /\bCookie\b/, label: "cookie credential handling" },
    { pattern: /\br\.Header\b/, label: "request header inspection" },
    { pattern: /\br\.URL\b/, label: "request URL/query inspection" },
    { pattern: /\b(access_token|credential_proof|session_token)\b/i, label: "credential token material" },
    { pattern: /\bHandshake\b/, label: "handshake authentication behavior" },
  ];
  for (const file of wsFiles) {
    const matches = textMatchesAny(sourceWithoutGoComments(readText(path.join(root, file))), forbiddenTransportPatterns);
