function checkContractSource(root, moduleName, contractType, expectedKind, entry, moduleInfo, moduleManifest) {
  const artifact = entry.path || `${moduleName}:${contractType}:${entry.id || "missing-id"}`;
  if (!entry.id) {
    fail(`${artifact} contract entry is missing id`, {
      rule_id: "contract.registry_entry",
      artifact,
    });
    return;
  }
  if (!entry.path) {
    fail(`${moduleName} ${contractType} ${entry.id} contract entry is missing path`, {
      rule_id: "contract.registry_entry",
      artifact,
    });
    return;
  }
  if (!entry.path.startsWith(`contracts/${moduleName}/`)) {
    fail(`${entry.path} is outside contracts/${moduleName}/`, {
      rule_id: "contract.registry_entry",
      artifact: entry.path,
    });
  } else {
    ok(`${entry.path} is under contracts/${moduleName}/`, {
      rule_id: "contract.registry_entry",
      artifact: entry.path,
    });
  }
  if (isFile(root, entry.path)) {
    ok(`${entry.path} exists`, {
      rule_id: "contract.source_exists",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} is missing`, {
      rule_id: "contract.source_exists",
      artifact: entry.path,
    });
    return;
  }

  const text = readText(path.join(root, entry.path));
  const schemaVersion = firstScalar(text, "schema_version");
  if (schemaVersion === "0.1") {
    ok(`${entry.path} declares schema_version: 0.1`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  } else {
