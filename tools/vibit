function protoMessageBody(text, messageName) {
  const messageMatch = new RegExp(`\\bmessage\\s+${messageName}\\s*\\{`, "m").exec(text);
  if (!messageMatch) {
    return null;
  }
  const bodyStart = messageMatch.index + messageMatch[0].length;
  let depth = 1;
  for (let i = bodyStart; i < text.length; i += 1) {
    const char = text[i];
    if (char === "{") {
      depth += 1;
    } else if (char === "}") {
      depth -= 1;
      if (depth === 0) {
        return text.slice(bodyStart, i);
      }
    }
  }
  return null;
}

function nestedSectionLines(text, sectionKey) {
  const lines = text.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `${sectionKey}:`);
  if (startIndex === -1) {
    return [];
  }
  const indent = (lines[startIndex].match(/^(\s*)/) || [""])[0].length;
  const body = [];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (line.trim() === "") {
      body.push(line);
      continue;
    }
    const currentIndent = (line.match(/^(\s*)/) || [""])[0].length;
    if (currentIndent <= indent) {
      break;
    }
    body.push(line);
  }
  return body;
}

function propertyNamesFromSection(text, sectionKey) {
  const lines = nestedSectionLines(text, sectionKey);
  const propertiesIndex = lines.findIndex((line) => line.trim() === "properties:");
  if (propertiesIndex === -1) {
    return [];
  }
  const propertiesIndent = (lines[propertiesIndex].match(/^(\s*)/) || [""])[0].length;
  const names = [];
  for (let i = propertiesIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    const match = line.match(/^(\s*)([A-Za-z_][A-Za-z0-9_]*):\s*$/);
    if (!match) {
      continue;
    }
    const indent = match[1].length;
    if (indent <= propertiesIndent) {
      break;
    }
    if (indent === propertiesIndent + 2) {
      names.push(match[2]);
    }
  }
  return names;
}

