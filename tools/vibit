        artifact: file,
      });
    }
  }

  const protoFiles = discoverFilesUnder(root, "proto")
    .filter((file) => file.endsWith(".proto"));
  const friendsProto = protoFiles.find((file) => {
    const text = readText(path.join(root, file));
    return /\bFriendRelationship\b|\bfriend_relationships\b|\bSendFriendRequest\b|\bAcceptFriendRequest\b/i.test(text);
  });
  if (friendsProto) {
