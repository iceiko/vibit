function runSubcheck(root, args) {
  if (!jsonOutput) {
    console.log(`\n==> vibit ${args.join(" ")}\n`);
  }
  const subcheckArgs = jsonOutput ? [...args, "--json"] : args;
  const result = childProcess.spawnSync(process.execPath, [__filename, ...subcheckArgs], {
    cwd: root,
    encoding: "utf8",
    maxBuffer: 1024 * 1024 * 16,
    stdio: jsonOutput ? ["ignore", "pipe", "pipe"] : "inherit",
  });
  if (result.error) {
    return {
      status: 1,
      result: {
        schema_version: "0.1",
        kind: "check_result",
        project: "vibit",
        check: args.join(" "),
        status: "failed",
        summary: { passed: 0, warnings: 0, failures: 1 },
        results: [{
          status: "failed",
          severity: "error",
          rule_id: "check.subcheck_spawn",
          artifact: args.join(" "),
          message: `could not run subcheck: ${result.error.message}`,
        }],
      },
    };
  }
  if (!jsonOutput) {
    return { status: result.status || 0, result: null };
  }
  try {
    return {
      status: result.status || 0,
      result: parseCheckResultSummary(result.stdout, args),
    };
  } catch (error) {
    return {
      status: 1,
      result: {
        schema_version: "0.1",
        kind: "check_result",
        project: "vibit",
        check: args.join(" "),
        status: "failed",
        summary: { passed: 0, warnings: 0, failures: 1 },
        results: [{
          status: "failed",
          severity: "error",
          rule_id: "check.subcheck_json_parse",
          artifact: args.join(" "),
          message: `subcheck did not return valid JSON: ${error.message}`,
        }],
      },
    };
  }
}

function checkAll(root) {
  if (!jsonOutput) {
    console.log(`Checking all vibit standards in ${root}`);
  }

  const checks = [["check", "architecture"], ["check", "schemas"], ["check", "memory"], ["check", "contracts"], ["check", "protocol"], ["check", "generated"], ["check", "runtime"]];

  for (const changeId of discoverChangeIds(root)) {
    checks.push(["check", "change", changeId]);
  }

  const modules = discoverRegisteredModules(root);
  for (const moduleName of modules) {
    checks.push(["check", "module", moduleName]);
  }

  if (modules.length === 0) {
    if (!jsonOutput) {
      console.log("WARN no registered modules found in .arch/modules.yaml");
    }
  }

  let failed = 0;
  const subchecks = [];
  for (const args of checks) {
    const subcheck = runSubcheck(root, args);
    subchecks.push(subcheck.result);
    if (subcheck.status !== 0) {
      failed += 1;
    }
  }

  if (jsonOutput) {
    const failedResults = subchecks.filter((item) => item && item.status === "failed").length;
    const aggregateResults = subchecks.map((item, index) => {
      const checkName = item ? item.check : checks[index].join(" ");
      const status = item && item.status === "passed" ? "passed" : "failed";
      return {
        status,
        severity: status === "passed" ? "info" : "error",
        rule_id: "check.subcheck",
        artifact: checkName,
        message: `${checkName} ${status}`,
      };
    });
    const subcheckSummaries = subchecks.map(summarizeSubcheckResult);
    printJson({
      schema_version: "0.1",
      kind: "check_result",
      project: "vibit",
      check: "check all",
      status: failed > 0 ? "failed" : "passed",
      summary: {
        subchecks: checks.length,
        passed: checks.length - failedResults,
        warnings: subchecks.reduce((sum, item) => sum + (item ? item.summary.warnings : 0), 0),
        failures: failedResults,
      },
      results: aggregateResults,
      subchecks: subcheckSummaries,
    });
    process.exit(failed > 0 ? 1 : 0);
  }

  if (failed > 0) {
    console.log(`\nResult: failed (${failed} subcheck${failed === 1 ? "" : "s"} failed)`);
    process.exit(1);
  }

  console.log(`\nResult: passed (${checks.length} subcheck${checks.length === 1 ? "" : "s"})`);
}

