    summary.payload_required = yamlListValuesAtPath(sourceText, ["payload", "required"]);
    summary.payload_properties = yamlMapKeysAtPath(sourceText, ["payload", "properties"]);
  }

  return summary;
}

function parseContractEntries(registry, moduleName, contractType) {
  const lines = registry.split(/\r?\n/);
  const moduleIndex = lines.findIndex((line) => line.trim() === `${moduleName}:`);
  if (moduleIndex === -1) {
    return [];
  }

  let moduleIndent = null;
  const moduleMatch = lines[moduleIndex].match(/^(\s*)/);
  moduleIndent = moduleMatch ? moduleMatch[1].length : 0;

  let typeIndex = -1;
  let typeIndent = -1;
  for (let i = moduleIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):\s*$/);
    if (!keyMatch) {
      continue;
    }
    const indent = keyMatch[1].length;
    if (indent <= moduleIndent) {
      break;
    }
    if (keyMatch[2] === contractType) {
      typeIndex = i;
      typeIndent = indent;
      break;
    }
  }

  if (typeIndex === -1) {
    return [];
  }

  const entries = [];
  let current = null;
  for (let i = typeIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^\S/.test(line)) {
      break;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= typeIndent) {
      break;
    }
    const idMatch = line.match(/^\s+- id:\s+(.+?)\s*$/);
    if (idMatch) {
      if (current) {
        entries.push(current);
      }
      current = { id: idMatch[1].replace(/^["']|["']$/g, ""), path: null };
      continue;
    }
    const pathMatch = line.match(/^\s+path:\s+(.+?)\s*$/);
    if (pathMatch && current) {
      current.path = pathMatch[1].replace(/^["']|["']$/g, "");
    }
  }
  if (current) {
    entries.push(current);
  }

  return entries;
}

