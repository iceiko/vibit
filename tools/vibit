  return [];
}

function protoMessageBody(text, messageName) {
  const messageMatch = new RegExp(`\\bmessage\\s+${messageName}\\s*\\{`, "m").exec(text);
  if (!messageMatch) {
    return null;
  }
  const bodyStart = messageMatch.index + messageMatch[0].length;
  let depth = 1;
  for (let i = bodyStart; i < text.length; i += 1) {
    const char = text[i];
    if (char === "{") {
      depth += 1;
    } else if (char === "}") {
      depth -= 1;
      if (depth === 0) {
        return text.slice(bodyStart, i);
      }
    }
  }
  return null;
}

function nestedSectionLines(text, sectionKey) {
  const lines = text.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `${sectionKey}:`);
  if (startIndex === -1) {
    return [];
  }
  const indent = (lines[startIndex].match(/^(\s*)/) || [""])[0].length;
  const body = [];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (line.trim() === "") {
      body.push(line);
      continue;
    }
    const currentIndent = (line.match(/^(\s*)/) || [""])[0].length;
    if (currentIndent <= indent) {
      break;
    }
    body.push(line);
  }
  return body;
}

function propertyNamesFromSection(text, sectionKey) {
  const lines = nestedSectionLines(text, sectionKey);
  const propertiesIndex = lines.findIndex((line) => line.trim() === "properties:");
  if (propertiesIndex === -1) {
    return [];
  }
  const propertiesIndent = (lines[propertiesIndex].match(/^(\s*)/) || [""])[0].length;
  const names = [];
  for (let i = propertiesIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    const match = line.match(/^(\s*)([A-Za-z_][A-Za-z0-9_]*):\s*$/);
    if (!match) {
      continue;
    }
    const indent = match[1].length;
    if (indent <= propertiesIndent) {
      break;
    }
    if (indent === propertiesIndent + 2) {
      names.push(match[2]);
    }
  }
  return names;
}

function expectedProtocolFields(root, contractType, entry) {
  if (!entry || !entry.path || !isFile(root, entry.path)) {
    return [];
  }
  const text = readText(path.join(root, entry.path));
  return expectedProtocolMessageSpecs(contractType, entry.id, entry.path).map((message) => ({
    ...message,
    fields: propertyNamesFromSection(text, message.source_section),
  }));
}

function checkRequiredText(root, relativePath, requiredText, ruleId, label) {
  if (!isFile(root, relativePath)) {
    fail(`${relativePath} is missing`, {
      rule_id: ruleId,
      artifact: relativePath,
    });
    return false;
  }
  const text = readText(path.join(root, relativePath));
  if (text.includes(requiredText)) {
    ok(`${relativePath} references ${label || requiredText}`, {
      rule_id: ruleId,
      artifact: relativePath,
    });
    return true;
  }
  fail(`${relativePath} does not reference ${label || requiredText}`, {
    rule_id: ruleId,
    artifact: relativePath,
  });
  return false;
}

function checkBufConfig(root) {
  const required = [
    ["buf.yaml", "version: v2"],
    ["buf.yaml", "path: proto"],
    ["buf.yaml", "STANDARD"],
    ["buf.yaml", "FILE"],
    ["buf.gen.yaml", "version: v2"],
    ["buf.gen.yaml", "remote: buf.build/protocolbuffers/go"],
    ["buf.gen.yaml", "out: runtime/internal/generated/proto"],
    ["buf.gen.yaml", "paths=source_relative"],
