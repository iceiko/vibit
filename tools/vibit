function checkRuntimeLayerBoundaries(root, goFiles) {
  const layerRules = [
    {
      ownerPrefix: "runtime/internal/app/",
      forbiddenImport: "github.com/iceiko/vibit/runtime/internal/platform/",
      allowedImports: ["github.com/iceiko/vibit/runtime/internal/platform/tx"],
      description: "application layer must not import platform adapters except the transaction boundary",
    },
    {
      ownerPrefix: "runtime/internal/app/",
      forbiddenImport: "github.com/iceiko/vibit/runtime/internal/generated/proto",
      description: "application layer must not import generated Protobuf packages",
    },
    {
      ownerPrefix: "runtime/internal/modules/",
      forbiddenImport: "github.com/iceiko/vibit/runtime/internal/platform/",
      description: "domain modules must not import platform adapters",
    },
    {
      ownerPrefix: "runtime/internal/modules/",
      forbiddenImport: "github.com/iceiko/vibit/runtime/internal/generated/proto",
      description: "domain modules must not import generated Protobuf packages",
    },
  ];

  for (const file of goFiles) {
    const matchingRules = layerRules.filter((rule) => pathStartsWith(file, rule.ownerPrefix));
    if (matchingRules.length === 0) {
      continue;
    }

    const text = readText(path.join(root, file));
    for (const rule of matchingRules) {
      const forbiddenImports = importsWithPrefix(text, rule.forbiddenImport);
      const allowedImports = rule.allowedImports || [];
      const violations = forbiddenImports.filter((importPath) => {
        return !allowedImports.some((allowedImport) => {
          return importPath === allowedImport || importPath.startsWith(`${allowedImport}/`);
        });
      });

      if (violations.length > 0) {
        fail(`${file} violates runtime layer boundary: ${rule.description}`, {
          rule_id: "runtime.layer_boundary",
          artifact: file,
        });
      } else {
        ok(`${file} respects runtime layer boundary: ${rule.description}`, {
          rule_id: "runtime.layer_boundary",
          artifact: file,
        });
      }
    }
  }
}

function importsWithPrefix(text, prefix) {
  const imports = [];
  const pattern = /"([^"]+)"/g;
  let match;
  while ((match = pattern.exec(text)) !== null) {
    if (match[1].startsWith(prefix)) {
      imports.push(match[1]);
    }
  }
  return imports;
}

function sourceWithoutGoComments(text) {
  return text
    .replace(/\/\*[\s\S]*?\*\//g, "")
    .replace(/\/\/.*$/gm, "");
}

function textMatchesAny(text, patterns) {
  return patterns.filter((item) => item.pattern.test(text));
}

