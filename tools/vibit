    if (!isFile(root, file)) {
      continue;
    }
    const text = readText(path.join(root, file));
    for (const match of textMatchesAny(text, forbiddenPatterns, root)) {
      fail(`${file} crosses friends relationship repository boundary with ${match.label}`, {
        rule_id: ruleId,
        artifact: file,
      });
    }
  }

  if (exists(root, forbiddenRuntimeModulePath) && !friendsRelationshipRepositoryInterfaceImplementationCompleted(root)) {
    fail(`${forbiddenRuntimeModulePath} must not be created by the repository boundary gate`, {
      rule_id: ruleId,
      artifact: forbiddenRuntimeModulePath,
    });
