    ["docs/agent-tooling.md", "node tools/vibit inspect next --json"],
    ["docs/agent-tooling.md", "node tools/vibit inspect reference --json"],
    ["docs/agent-tooling.md", "node tools/vibit generate contract-shapes all"],
    ["docs/agent-tooling.md", "forward-slash form"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit inspect contracts --json"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit inspect generated --json"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit inspect contracts --type command --json"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit inspect generated --module inventory --json"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit inspect next --json"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit inspect reference --json"],
    ["docs/agent-tooling.zh-CN.md", "node tools/vibit generate contract-shapes all"],
    ["docs/agent-tooling.zh-CN.md", "forward-slash form"],
    [".arch/conventions.yaml", "agent_tooling_standard:"],
    [".arch/conventions.yaml", "Repository-relative paths in JSON tooling output use forward slashes"],
    [".arch/runtime.yaml", "tooling_runtime:"],
    [".arch/reference.yaml", "agent_native_maintainability"],
    ["AGENTS.md", "node tools/vibit inspect work"],
    ["AGENTS.md", "including Windows"],
    ["AGENTS.zh-CN.md", "包括 Windows"],
  ]) {
