    const forbiddenMatches = textMatchesAny(sourceWithoutComments, forbiddenSourcePatterns);
    if (forbiddenMatches.length === 0) {
      ok(`${serviceSource} keeps device credential login service-local without protocol, startup, or adapter shortcuts`, {
        rule_id: ruleId,
        artifact: serviceSource,
