      fail(`${file} crosses friends relationship repository-boundary-only scope with ${match.label}`, {
        rule_id: ruleId,
        artifact: file,
      });
    }
  }

  const friendsAdapterFiles = goFiles
    .filter((file) => !file.endsWith("_test.go"))
    .filter((file) => pathStartsWith(file, "runtime/internal/platform/persistence/postgres/"))
    .filter((file) => {
      const text = sourceWithoutGoComments(readText(path.join(root, file)));
      return /\bfriend_relationships\b|\bFriendRelationship\b|\bSendFriendRequest\b|\bAcceptFriendRequest\b/.test(text);
