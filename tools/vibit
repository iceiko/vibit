      fail(`${file} is missing runtime authentication implementation boundary markers`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    const text = readText(path.join(root, file));
    for (const marker of statusMarkers) {
      if (text.includes(marker)) {
        ok(`${file} preserves runtime authentication implementation boundary marker ${marker}`, {
          rule_id: ruleId,
          artifact: file,
        });
      } else {
        fail(`${file} is missing runtime authentication implementation boundary marker ${marker}`, {
          rule_id: ruleId,
          artifact: file,
        });
      }
    }
  }

  const behaviorFiles = goFiles
    .filter((file) => !file.endsWith("_test.go"))
    .filter((file) => pathStartsWith(file, "runtime/internal/app/") ||
      pathStartsWith(file, "runtime/internal/platform/protocol/protobuf/") ||
      pathStartsWith(file, "runtime/internal/platform/transport/ws/") ||
      pathStartsWith(file, "runtime/internal/modules/"));
  const forbiddenPatterns = [
    { pattern: /\b(AuthService|Authenticator|TokenValidator|TokenIssuer|TokenVerifier)\b/, label: "runtime authentication service or token component" },
    { pattern: /\bAuthenticateWithDeviceCredential\b/, label: "runtime login execution" },
    { pattern: /\bValidateAccessToken\b/, label: "runtime access-token validation" },
    { pattern: /\bLogoutAccessToken\b/, label: "runtime logout execution" },
    { pattern: /\bcrypto\/rand\b/, label: "token or credential material generation" },
    { pattern: /\bBearer\b/, label: "bearer token handling" },
  ];
  for (const file of behaviorFiles) {
    if (file === "runtime/internal/modules/authentication/repository.go") {
      continue;
    }
    if (isExplicitVerifierKeySetValidatorFile(file)) {
      ok(`${file} is the ADR-0045-authorized explicit verifier key set validator and does not implement verifier algorithm behavior`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    if (isEnvironmentVerifierKeyLoaderFile(file)) {
      ok(`${file} is the W-0099-authorized environment verifier key loader and does not implement runtime authentication behavior`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    if (isMaterialGenerationHelperFile(file)) {
      ok(`${file} is the W-0101-authorized material generation helper and does not implement runtime authentication behavior`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    if (isVerifierDigestHelperFile(file)) {
      ok(`${file} is the W-0103-authorized verifier digest helper and does not implement runtime authentication service behavior`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    if (isVerifierDigestComparisonHelperFile(file)) {
      ok(`${file} is the W-0105-authorized verifier digest comparison helper and does not implement runtime authentication service behavior`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    if (isAuthenticationServiceSkeletonFile(file)) {
      ok(`${file} is the W-0107-authorized authentication service skeleton and does not execute runtime authentication behavior`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    const rawText = readText(path.join(root, file));
    const text = sourceWithoutGoComments(rawText);
    const matches = textMatchesAny(text, forbiddenPatterns);
    if (matches.length === 0) {
      ok(`${file} does not implement runtime authentication before implementation boundary gates`, {
        rule_id: ruleId,
        artifact: file,
      });
      continue;
    }
    for (const match of matches) {
      fail(`${file} crosses runtime authentication implementation boundary: ${match.label}`, {
        rule_id: ruleId,
        artifact: file,
      });
    }
  }
}

