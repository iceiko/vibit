      rule_id: ruleId,
      artifact: "proto",
    });
  }

  const generatedFiles = discoverFilesUnder(root, "runtime/internal/generated")
    .filter((file) => file.endsWith(".go"));
  const friendsGenerated = generatedFiles.find((file) => {
    const text = sourceWithoutGoComments(readText(path.join(root, file)));
    return /\bFriendRelationship\b|\bSendFriendRequest\b|\bAcceptFriendRequest\b|\bfriend_relationships\b/i.test(text);
  });
  if (friendsGenerated) {
    fail(`${friendsGenerated} adds friends relationship generated output during repository boundary gate`, {
      rule_id: ruleId,
      artifact: friendsGenerated,
    });
  } else {
    ok("no friends relationship generated output is added by friends relationship repository boundary", {
      rule_id: ruleId,
      artifact: "runtime/internal/generated",
    });
  }

  const directCompatibilityPatterns = [
    { pattern: /\/v2\/(?:account|user|storage|notification|channel|stream|match|rpc|group|friend)/i, label: "Nakama REST path" },
    { pattern: /\bnk\.(?:account|users?|storage|notification|channel|stream|match|rpc|group|friends?)_/i, label: "Nakama runtime API name" },
    { pattern: /\bpitaya\.(?:Push|Group|Broadcast|RPC|Remote|Send|Session|Route)\b/i, label: "Pitaya API namespace" },
  ];
  for (const file of [standardPath, standardTranslationPath, decisionPath, `${changePath}/spec.yaml`, `${changePath}/request.md`, conversationPath]) {
    if (!isFile(root, file)) {
      continue;
    }
    const text = readText(path.join(root, file));
    const matches = textMatchesAny(text, directCompatibilityPatterns);
    if (matches.length === 0) {
      ok(`${file} avoids direct Nakama/Pitaya API compatibility markers`, {
        rule_id: ruleId,
        artifact: file,
      });
    } else {
      for (const match of matches) {
        fail(`${file} adds direct compatibility marker: ${match.label}`, {
          rule_id: ruleId,
          artifact: file,
        });
      }
    }
  }

  ok("Friends relationship repository boundary completes W-0234, opens W-0235, records storage-neutral Nakama-first repository vocabulary, and preserves adapter/runtime/protocol/generated/dependency/event/direct compatibility deferrals", {
    rule_id: ruleId,
    artifact: standardPath,
