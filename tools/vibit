  } else {
    fail(`${entry.path} kind does not match ${expectedKind}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  }
  const module = firstScalar(text, "module");
  if (module === moduleName) {
    ok(`${entry.path} module is ${moduleName}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} module does not match ${moduleName}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  }
  const status = firstScalar(text, "status");
  if (["draft", "active", "deprecated"].includes(status)) {
    ok(`${entry.path} status is ${status}`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} status is invalid or missing`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  }

  if (["commands", "queries", "events"].includes(contractType)) {
    const name = firstScalar(text, "name");
    if (name === entry.id) {
      ok(`${entry.path} name matches registry id ${entry.id}`, {
        rule_id: "contract.source_match",
        artifact: entry.path,
      });
    } else {
      fail(`${entry.path} name does not match registry id ${entry.id}`, {
        rule_id: "contract.source_match",
        artifact: entry.path,
      });
    }
  }

  const declared = {
    commands: moduleInfo.public_api.commands,
    queries: moduleInfo.public_api.queries,
    events: moduleInfo.events.publishes,
  };
  if (declared[contractType]) {
    if (declared[contractType].includes(entry.id)) {
      ok(`${entry.id} is declared by modules/${moduleName}/module.yaml`, {
        rule_id: "contract.source_match",
        artifact: `modules/${moduleName}/module.yaml`,
      });
    } else {
      fail(`${entry.id} is not declared by modules/${moduleName}/module.yaml`, {
        rule_id: "contract.source_match",
        artifact: `modules/${moduleName}/module.yaml`,
      });
    }
  }

  if (moduleManifest.includes(entry.path)) {
    ok(`modules/${moduleName}/module.yaml references ${entry.path}`, {
      rule_id: "contract.source_match",
      artifact: `modules/${moduleName}/module.yaml`,
