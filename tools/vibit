  if (protoText.includes("package vibit.protocol.v1;")) {
    ok(`${protoPath} declares package vibit.protocol.v1`, {
      rule_id: "protocol.package",
      artifact: protoPath,
    });
  } else {
    fail(`${protoPath} does not declare package vibit.protocol.v1`, {
      rule_id: "protocol.package",
      artifact: protoPath,
