function checkProtocol(root) {
  resetResults("check protocol");
  if (!jsonOutput) {
    console.log(`Checking protocol alignment in ${root}\n`);
  }

  checkProtocolFrameworkManifest(root);

  const registryPath = ".arch/contracts.yaml";
  const protoRoot = "proto";
  if (isDirectory(root, protoRoot)) {
    ok("proto/ exists", {
      rule_id: "protocol.source_root",
      artifact: protoRoot,
    });
  } else {
    fail("proto/ is missing", {
      rule_id: "protocol.source_root",
      artifact: protoRoot,
    });
    finish();
    return;
  }

  checkBufConfig(root);

  if (!isFile(root, registryPath)) {
    fail(`${registryPath} is missing`, {
      rule_id: "contract.registry_declared",
      artifact: registryPath,
    });
    finish();
    return;
  }

  const registry = readText(path.join(root, registryPath));
  const checkStatus = firstScalar(sectionBody(registry, "source_alignment").join("\n"), "check_status") || firstScalar(registry, "check_status");
  const strictAlignment = protocolAlignmentIsStrict(checkStatus);
  const protoFiles = discoverProtoFiles(root);
  const plannedMissingAllowed = !strictAlignment && protoFiles.length === 0;
  if (protoFiles.length === 0 && strictAlignment) {
    fail("protocol alignment is active but no .proto files exist", {
      rule_id: "protocol.source_root",
      artifact: protoRoot,
    });
  } else if (plannedMissingAllowed) {
    ok(`no .proto files yet; protocol alignment allows planned missing files (${checkStatus || "unspecified"})`, {
      rule_id: "protocol.planned_missing",
      artifact: protoRoot,
    });
  }

  checkProtocolEnvelopeProto(root, protoFiles);

  const contractTypes = ["commands", "queries", "events"];
  let expectedMessages = 0;
  for (const moduleName of discoverRegisteredModules(root)) {
    const moduleManifestPath = `modules/${moduleName}/module.yaml`;
    const moduleManifest = isFile(root, moduleManifestPath)
      ? readText(path.join(root, moduleManifestPath))
      : "";
    const boundaryOnlyContracts = isBoundaryOnlyContractModule(registry, moduleName, moduleManifest);
    const hasProtocolContracts = contractTypes
      .some((contractType) => parseContractEntries(registry, moduleName, contractType).length > 0);
    if (boundaryOnlyContracts && !hasProtocolContracts) {
      ok(`${moduleName} is boundary-only with no Protobuf source required yet`, {
        rule_id: "contract.boundary_only",
        artifact: moduleManifestPath,
      });
      continue;
    }

    const protoPath = protoSourcePathForModule(moduleName);
    const packageName = protoPackageForModule(moduleName);
    if (isDirectory(root, `proto/vibit/${moduleName}/v1`)) {
      ok(`proto/vibit/${moduleName}/v1 exists`, {
        rule_id: "protocol.source_root",
        artifact: `proto/vibit/${moduleName}/v1`,
      });
    } else {
      fail(`proto/vibit/${moduleName}/v1 is missing`, {
        rule_id: "protocol.source_root",
        artifact: `proto/vibit/${moduleName}/v1`,
      });
    }

    const protoExists = isFile(root, protoPath);
    const protoText = protoExists ? readText(path.join(root, protoPath)) : "";
    if (protoExists) {
      ok(`${protoPath} exists`, {
        rule_id: "protocol.source_root",
        artifact: protoPath,
      });
      if (protoText.includes(`package ${packageName};`)) {
        ok(`${protoPath} declares package ${packageName}`, {
          rule_id: "protocol.package",
          artifact: protoPath,
        });
      } else {
        fail(`${protoPath} does not declare package ${packageName}`, {
          rule_id: "protocol.package",
          artifact: protoPath,
        });
      }
      checkProtoGoPackage(root, protoPath, `github.com/iceiko/vibit/runtime/internal/generated/proto/vibit/${moduleName}/v1;${moduleName}v1`);
      if (protoText.includes("contracts/") || protoText.includes("@source")) {
        ok(`${protoPath} declares contract source trace`, {
          rule_id: "protocol.source_trace",
          artifact: protoPath,
        });
      } else {
        fail(`${protoPath} is missing contract source trace`, {
          rule_id: "protocol.source_trace",
          artifact: protoPath,
        });
      }
    } else if (!plannedMissingAllowed) {
      fail(`${protoPath} is missing while protocol source files are active`, {
        rule_id: "protocol.source_root",
        artifact: protoPath,
      });
    } else {
      ok(`${protoPath} is planned but not created`, {
        rule_id: "protocol.planned_missing",
        artifact: protoPath,
      });
    }

    for (const contractType of contractTypes) {
      const entries = parseContractEntries(registry, moduleName, contractType);
      for (const entry of entries) {
        const messages = expectedProtocolMessages(contractType, entry.id);
        expectedMessages += messages.length;
        const declaredMessages = new Set();
        for (const messageName of messages) {
          if (!protoExists) {
            ok(`${messageName} is planned in ${protoPath}`, {
              rule_id: "protocol.planned_missing",
              artifact: protoPath,
            });
            continue;
          }
          const messagePattern = new RegExp(`\\bmessage\\s+${messageName}\\b`);
          if (messagePattern.test(protoText)) {
            declaredMessages.add(messageName);
            ok(`${protoPath} declares message ${messageName}`, {
              rule_id: "protocol.message",
              artifact: protoPath,
            });
          } else {
            fail(`${protoPath} is missing message ${messageName}`, {
              rule_id: "protocol.message",
              artifact: protoPath,
            });
          }
        }

        if (protoExists) {
          for (const message of expectedProtocolFields(root, contractType, entry)) {
            if (!declaredMessages.has(message.name)) {
              continue;
            }
            const messageBody = protoMessageBody(protoText, message.name);
            if (messageBody === null) {
              fail(`${protoPath} has malformed message ${message.name}`, {
                rule_id: "protocol.message",
                artifact: protoPath,
              });
              continue;
            }
            for (const fieldName of message.fields) {
              const fieldPattern = new RegExp(`\\b${fieldName}\\s*=\\s*\\d+\\s*;`);
              if (fieldPattern.test(messageBody)) {
                ok(`${protoPath} ${message.name} declares field ${fieldName}`, {
                  rule_id: "protocol.field",
                  artifact: protoPath,
                });
              } else {
                fail(`${protoPath} ${message.name} is missing field ${fieldName}`, {
                  rule_id: "protocol.field",
                  artifact: protoPath,
                });
              }
            }
            if (messageBody.includes(message.source) || messageBody.includes("@source") || protoText.includes(message.source)) {
              ok(`${protoPath} ${message.name} declares source trace`, {
                rule_id: "protocol.source_trace",
                artifact: protoPath,
              });
            } else {
              fail(`${protoPath} ${message.name} is missing source trace`, {
                rule_id: "protocol.source_trace",
                artifact: protoPath,
              });
            }
          }
        }
      }
    }
  }

  finish({
    summary_counts: {
      proto_files: protoFiles.length,
      expected_messages: expectedMessages,
    },
  });
}

function checkGenerated(root) {
  resetResults("check generated");
  if (!jsonOutput) {
    console.log(`Checking generated files in ${root}\n`);
  }

  for (const moduleName of discoverRegisteredModules(root)) {
    const moduleInfo = loadModuleInfo(root, moduleName);
    if (!moduleInfo.exists) {
      fail(`modules/${moduleName}/module.yaml is missing`, {
        rule_id: "artifact.required",
        artifact: `modules/${moduleName}/module.yaml`,
      });
      continue;
    }

    const declaredFiles = moduleInfo.generated.files;
    const declaredDirectories = moduleInfo.generated.directories;
    if (declaredFiles.length > 0 || declaredDirectories.length > 0) {
      ok(`modules/${moduleName}/module.yaml declares generated outputs`, {
        rule_id: "generated.declared",
        artifact: `modules/${moduleName}/module.yaml`,
      });
    } else {
      ok(`modules/${moduleName}/module.yaml has no generated files yet`, {
        rule_id: "generated.declared",
        artifact: `modules/${moduleName}/module.yaml`,
      });
    }

    for (const directory of declaredDirectories) {
      const directoryPath = `modules/${moduleName}/${directory}`;
      if (isDirectory(root, directoryPath)) {
        ok(`${directoryPath}/ exists`, {
          rule_id: "artifact.directory_exists",
          artifact: directoryPath,
        });
      } else {
        fail(`${directoryPath}/ is missing`, {
          rule_id: "artifact.directory_exists",
          artifact: directoryPath,
        });
      }
    }

    for (const file of declaredFiles) {
      const filePath = `modules/${moduleName}/${file}`;
      if (!isFile(root, filePath)) {
        fail(`${filePath} is missing`, {
          rule_id: "generated.exists",
          artifact: filePath,
        });
        continue;
      }
      ok(`${filePath} exists`, {
        rule_id: "generated.exists",
        artifact: filePath,
      });

      const text = readText(path.join(root, filePath));
      if (text.includes("@generated")) {
        ok(`${filePath} declares @generated`, {
          rule_id: "generated.trace",
          artifact: filePath,
        });
      } else {
        fail(`${filePath} is missing @generated marker`, {
          rule_id: "generated.trace",
          artifact: filePath,
        });
      }
      if (text.includes("Source: ")) {
        ok(`${filePath} declares source trace`, {
          rule_id: "generated.trace",
          artifact: filePath,
        });
      } else {
        fail(`${filePath} is missing source trace`, {
          rule_id: "generated.trace",
          artifact: filePath,
        });
      }
      if (text.includes("Generator: ")) {
        ok(`${filePath} declares generator trace`, {
          rule_id: "generated.trace",
          artifact: filePath,
        });
      } else {
        fail(`${filePath} is missing generator trace`, {
          rule_id: "generated.trace",
          artifact: filePath,
        });
      }
    }
  }

  checkGeneratedProtoOutput(root);
  checkGeneratedContractShapeOutput(root);

  finish();
}

function checkTranslationPair(root, englishPath, chinesePath) {
  if (isFile(root, englishPath) && isFile(root, chinesePath)) {
