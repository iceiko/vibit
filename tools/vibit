}

function checkProtoGoPackage(root, protoPath, expectedGoPackage) {
  checkRequiredText(root, protoPath, `option go_package = "${expectedGoPackage}";`, "protocol.go_package", expectedGoPackage);
}

function checkProtoMessageShape(root, protoPath, protoText, messageName, fieldNames, ruleId = "protocol.message") {
  const messagePattern = new RegExp(`\\bmessage\\s+${messageName}\\b`);
  if (messagePattern.test(protoText)) {
    ok(`${protoPath} declares message ${messageName}`, {
      rule_id: ruleId,
      artifact: protoPath,
    });
  } else {
    fail(`${protoPath} is missing message ${messageName}`, {
      rule_id: ruleId,
      artifact: protoPath,
    });
    return;
  }

  const messageBody = protoMessageBody(protoText, messageName);
  if (messageBody === null) {
    fail(`${protoPath} has malformed message ${messageName}`, {
      rule_id: "protocol.message",
      artifact: protoPath,
    });
    return;
  }

  for (const fieldName of fieldNames) {
    const fieldPattern = new RegExp(`\\b${fieldName}\\s*=\\s*\\d+\\s*;`);
    if (fieldPattern.test(messageBody)) {
      ok(`${protoPath} ${messageName} declares field ${fieldName}`, {
        rule_id: "protocol.field",
        artifact: protoPath,
      });
    } else {
      fail(`${protoPath} ${messageName} is missing field ${fieldName}`, {
        rule_id: "protocol.field",
        artifact: protoPath,
      });
    }
  }
}

function checkProtoEnumValues(root, protoPath, protoText, enumName, values) {
  const enumPattern = new RegExp(`\\benum\\s+${enumName}\\s*\\{`, "m");
  const enumMatch = enumPattern.exec(protoText);
  if (!enumMatch) {
    fail(`${protoPath} is missing enum ${enumName}`, {
      rule_id: "protocol.message",
      artifact: protoPath,
    });
    return;
  }
  ok(`${protoPath} declares enum ${enumName}`, {
    rule_id: "protocol.message",
    artifact: protoPath,
  });

  const bodyStart = enumMatch.index + enumMatch[0].length;
  const endIndex = protoText.indexOf("}", bodyStart);
  const enumBody = endIndex === -1 ? "" : protoText.slice(bodyStart, endIndex);
  for (const value of values) {
    const valuePattern = new RegExp(`\\b${value}\\s*=\\s*\\d+\\s*;`);
    if (valuePattern.test(enumBody)) {
      ok(`${protoPath} ${enumName} declares value ${value}`, {
        rule_id: "protocol.enum_value",
        artifact: protoPath,
      });
    } else {
      fail(`${protoPath} ${enumName} is missing value ${value}`, {
        rule_id: "protocol.enum_value",
        artifact: protoPath,
      });
    }
  }
}

function checkProtocolEnvelopeProto(root, protoFiles) {
  if (protoFiles.length === 0) {
    return;
  }

  const protoPath = "proto/vibit/protocol/v1/envelope.proto";
  if (!isFile(root, protoPath)) {
    fail(`${protoPath} is missing while protocol source files are active`, {
