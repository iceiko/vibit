      fail(`${registryPath} runtime ${config.registryFamily} is missing marker ${marker}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
    }
  }

  for (const [contractType, expectedKind] of contractTypes) {
    const entries = parseContractEntries(familyBlock, config.registryFamily, contractType);
    if (contractType === "queries" && entries.length === 0) {
      ok(`${registryPath} records no runtime ${config.registryFamily} queries`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
