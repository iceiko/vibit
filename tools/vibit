function discoverRuntimeTestFiles(root) {
  const files = [];
  const runtimeDir = path.join(root, "runtime");
  function walk(dir) {
    if (!fs.existsSync(dir)) {
      return;
    }
    for (const name of fs.readdirSync(dir).sort()) {
      const fullPath = path.join(dir, name);
      const stat = fs.statSync(fullPath);
      if (stat.isDirectory()) {
        walk(fullPath);
      } else if (/_test\.go$/.test(name)) {
        files.push(rel(root, fullPath));
      }
    }
  }
  walk(runtimeDir);
  return files;
}

function discoverRuntimeGoFiles(root) {
