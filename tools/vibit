    fail(`${serviceTests} is missing for device credential login service behavior implementation`, {
      rule_id: ruleId,
      artifact: serviceTests,
    });
  }

  const changedRuntimeFiles = goFiles.filter((file) => {
    if (!file.startsWith("runtime/internal/app/authentication/")) {
      return false;
    }
    if (file.endsWith("_test.go")) {
      return false;
    }
    return !isAuthenticationServiceFile(file) &&
      !isExplicitVerifierKeySetValidatorFile(file) &&
      !isEnvironmentVerifierKeyLoaderFile(file) &&
      !isMaterialGenerationHelperFile(file) &&
      !isVerifierDigestHelperFile(file) &&
      !isVerifierDigestComparisonHelperFile(file) &&
      !isRouteAuthenticationValidatorFile(file);
  });
  if (changedRuntimeFiles.length === 0) {
    ok("device credential login implementation remains inside the service slice and existing helper files", {
      rule_id: ruleId,
      artifact: "runtime/internal/app/authentication",
    });
  } else {
