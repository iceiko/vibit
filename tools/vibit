    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= currentIndent) {
      break;
    }
    const itemMatch = line.match(/^\s+-\s+(.+?)\s*$/);
    if (itemMatch) {
      values.push(itemMatch[1].replace(/^["']|["']$/g, ""));
    }
  }
  return values;
}

function yamlBlockRange(lines, pathKeys) {
  let startIndex = -1;
  let currentIndent = -1;

  for (const key of pathKeys) {
    let found = false;
    for (let i = startIndex + 1; i < lines.length; i += 1) {
      const line = lines[i];
      const match = line.match(/^(\s*)([A-Za-z0-9_-]+):\s*$/);
      if (!match) {
        continue;
      }
      const indent = match[1].length;
      const name = match[2];
      if (indent <= currentIndent && startIndex !== -1) {
        break;
      }
      if (name === key) {
        startIndex = i;
        currentIndent = indent;
        found = true;
        break;
      }
    }
    if (!found) {
      return { start: -1, end: -1, indent: -1 };
    }
  }

  let end = lines.length;
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (!line.trim()) {
      continue;
    }
    const indent = line.match(/^(\s*)/)[1].length;
    if (indent <= currentIndent && /^[A-Za-z0-9_-]+:/.test(line.trim())) {
      end = i;
      break;
    }
  }
  return { start: startIndex, end, indent: currentIndent };
}

function yamlListValuesAtPath(text, pathKeys) {
  const lines = text.split(/\r?\n/);
  const range = yamlBlockRange(lines, pathKeys);
  if (range.start === -1) {
    return [];
  }

  const values = [];
  const itemIndent = range.indent + 2;
  for (let i = range.start + 1; i < range.end; i += 1) {
    const line = lines[i];
    const match = line.match(/^(\s*)-\s+(.+?)\s*$/);
    if (match && match[1].length === itemIndent) {
      values.push(unquoteScalar(match[2]));
    }
  }
  return values;
}

function yamlMapKeysAtPath(text, pathKeys) {
  const lines = text.split(/\r?\n/);
  const range = yamlBlockRange(lines, pathKeys);
  if (range.start === -1) {
