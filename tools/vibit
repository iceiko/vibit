    artifact: protoPath,
  });

  const bodyStart = enumMatch.index + enumMatch[0].length;
  const endIndex = protoText.indexOf("}", bodyStart);
  const enumBody = endIndex === -1 ? "" : protoText.slice(bodyStart, endIndex);
  for (const value of values) {
    const valuePattern = new RegExp(`\\b${value}\\s*=\\s*\\d+\\s*;`);
    if (valuePattern.test(enumBody)) {
      ok(`${protoPath} ${enumName} declares value ${value}`, {
