function discoverContractRegistryEntries(root) {
  const registryPath = ".arch/contracts.yaml";
  if (!isFile(root, registryPath)) {
    return [];
  }
  const registry = readText(path.join(root, registryPath));
  const entries = [];
  const contractTypes = ["commands", "queries", "events", "errors", "permissions"];

  for (const moduleName of discoverRegisteredModules(root)) {
    for (const contractType of contractTypes) {
      for (const entry of parseContractEntries(registry, moduleName, contractType)) {
        entries.push({
          module: moduleName,
          family: null,
          type: singularContractType(contractType),
          normalized_type: contractType,
          kind: contractKindForType(contractType),
          id: entry.id,
          path: entry.path,
          owner: `modules/${moduleName}`,
        });
      }
    }
  }

  for (const family of runtimeContractFamilies()) {
    const familyBlock = runtimeContractFamilyBlock(registry, family.registryFamily);
    if (!familyBlock) {
      continue;
    }
    for (const contractType of contractTypes) {
      for (const entry of parseContractEntries(familyBlock, family.registryFamily, contractType)) {
        entries.push({
          module: "runtime",
          family: family.family,
          registry_family: family.registryFamily,
          type: singularContractType(contractType),
          normalized_type: contractType,
          kind: contractKindForType(contractType),
          id: entry.id,
          path: entry.path,
          owner: family.owner,
        });
      }
    }
  }

  return entries.sort((left, right) => {
    const leftKey = `${left.module}:${left.family || ""}:${left.normalized_type}:${left.id}`;
    const rightKey = `${right.module}:${right.family || ""}:${right.normalized_type}:${right.id}`;
    return leftKey.localeCompare(rightKey);
  });
}

function registryModuleBlock(registry, moduleName) {
  const lines = registry.split(/\r?\n/);
  const moduleIndex = lines.findIndex((line) => line.trim() === `${moduleName}:`);
  if (moduleIndex === -1) {
    return "";
  }

  const moduleMatch = lines[moduleIndex].match(/^(\s*)/);
  const moduleIndent = moduleMatch ? moduleMatch[1].length : 0;
  const block = [lines[moduleIndex]];

  for (let i = moduleIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (!line.trim()) {
      block.push(line);
      continue;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= moduleIndent) {
      break;
    }
    block.push(line);
  }

  return block.join("\n");
}

