function loadChangeInfo(root, changeId) {
  const dir = changeDirectory(root, changeId);
  const specPath = path.join(dir, "spec.yaml");
  const existsOnDisk = fs.existsSync(dir) && fs.statSync(dir).isDirectory();
  const specExists = fs.existsSync(specPath) && fs.statSync(specPath).isFile();
  const files = {};
  for (const file of CHANGE_SPEC_REQUIRED_FILES) {
    const target = path.join(dir, file);
    files[file] = fs.existsSync(target) && fs.statSync(target).isFile();
  }

  const change = {
    change_id: changeId,
    declared_change_id: null,
    exists: existsOnDisk,
    path: rel(root, dir),
    spec: rel(root, specPath),
    spec_exists: specExists,
    date: null,
    type: null,
    status: null,
    summary: null,
    affected_modules: [],
    verification: {
      required: [],
      status: null,
    },
    files,
  };

  if (specExists) {
    const spec = readText(specPath);
    change.declared_change_id = firstScalar(spec, "change_id");
    change.date = firstScalar(spec, "date");
    change.type = firstScalar(spec, "type");
    change.status = firstScalar(spec, "status");
    change.summary = firstScalar(spec, "summary");
    change.affected_modules = listAfterKey(spec, "affected_modules");
    change.verification.required = listAfterPath(spec, ["verification", "required"]);
    change.verification.status = firstScalar(sectionBody(spec, "verification").join("\n"), "status");
  }

  return change;
}

function loadWorkState(root) {
  const manifestPath = ".arch/work-items.yaml";
  const existsOnDisk = isFile(root, manifestPath);
  const text = existsOnDisk ? readText(path.join(root, manifestPath)) : "";
  const milestones = existsOnDisk ? parseYamlListObjects(text, "milestones") : [];
  const workItems = existsOnDisk ? parseYamlListObjects(text, "work_items") : [];
  const currentMilestone = existsOnDisk ? firstScalar(text, "current_milestone") : null;
  const itemsById = new Map(workItems.map((item) => [item.id, item]));

  const nextReady = workItems.filter((item) => item.status === "next_ready");
  const active = workItems.filter((item) => item.status === "active");
  const blocked = workItems.filter((item) => item.status === "blocked");
  const completed = workItems.filter((item) => item.status === "completed");
  const planned = workItems.filter((item) => item.status === "planned");

  return {
    manifest: manifestPath,
    exists: existsOnDisk,
    schema_version: existsOnDisk ? firstScalar(text, "schema_version") : null,
    status: existsOnDisk ? firstScalar(text, "status") : null,
    standard: existsOnDisk ? firstScalar(text, "standard") : null,
    current_milestone: currentMilestone,
    milestones,
    work_items: workItems,
    indexes: {
      items_by_id: itemsById,
      milestone_ids: new Set(milestones.map((milestone) => milestone.id)),
    },
    summary: {
      milestones: milestones.length,
      work_items: workItems.length,
      next_ready: nextReady.length,
      active: active.length,
      blocked: blocked.length,
      completed: completed.length,
      planned: planned.length,
    },
    current: {
      milestone: milestones.find((milestone) => milestone.id === currentMilestone) || null,
      active,
      next_ready: nextReady,
      blocked,
    },
  };
}

