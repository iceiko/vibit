      });
    } else {
      fail(`${protoPath} is missing source trace ${source}`, {
        rule_id: "protocol.source_trace",
        artifact: protoPath,
      });
    }
  }

  checkProtoMessageShape(root, protoPath, protoText, "Envelope", [
    "protocol_version",
    "kind",
    "request_id",
    "module",
    "name",
    "target",
    "session",
    "payload_type",
    "payload",
    "error",
  ], "protocol.envelope");

  checkProtoMessageShape(root, protoPath, protoText, "Target", ["scope", "id"], "protocol.envelope");
  checkProtoMessageShape(root, protoPath, protoText, "Session", ["connection_id", "session_id", "player_id", "connection_epoch"], "protocol.envelope");
  checkProtoMessageShape(root, protoPath, protoText, "Error", ["code", "message", "request_id", "retryable", "details"], "protocol.envelope");

  checkProtoEnumValues(root, protoPath, protoText, "MessageKind", [
    "MESSAGE_KIND_UNSPECIFIED",
    "MESSAGE_KIND_COMMAND",
    "MESSAGE_KIND_QUERY",
    "MESSAGE_KIND_EVENT",
    "MESSAGE_KIND_ERROR",
    "MESSAGE_KIND_SYSTEM",
    "MESSAGE_KIND_ACK",
    "MESSAGE_KIND_HEARTBEAT",
    "MESSAGE_KIND_INPUT",
    "MESSAGE_KIND_STATE",
  ]);

  checkProtoEnumValues(root, protoPath, protoText, "TargetScope", [
    "TARGET_SCOPE_UNSPECIFIED",
    "TARGET_SCOPE_GLOBAL",
    "TARGET_SCOPE_PLAYER",
    "TARGET_SCOPE_PARTY",
    "TARGET_SCOPE_ROOM",
    "TARGET_SCOPE_MATCH",
    "TARGET_SCOPE_STREAM",
    "TARGET_SCOPE_SYSTEM",
  ]);
}

function protocolAlignmentIsStrict(checkStatus) {
  return checkStatus === "active";
}

function firstMarkdownField(text, fieldName) {
  const match = text.match(new RegExp(`^${fieldName}:\\s*(.+?)\\s*$`, "m"));
  if (!match) {
    return null;
  }
  return match[1].trim();
}

function firstMarkdownHeading(text) {
  const match = text.match(/^#\s+(.+?)\s*$/m);
  return match ? match[1].trim() : null;
}

function cleanMarkdownListValue(value) {
  let cleaned = value.trim();
  if (cleaned.startsWith("`") && cleaned.endsWith("`")) {
    cleaned = cleaned.slice(1, -1);
  }
  if (/^none yet\.?$/i.test(cleaned)) {
    return null;
  }
  return cleaned;
}

function markdownListAfterLabel(text, label) {
  const lines = text.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `${label}:`);
  if (startIndex === -1) {
    return [];
  }
  const values = [];
  let sawList = false;
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const trimmed = lines[i].trim();
    if (trimmed === "") {
      continue;
    }
    if (trimmed.startsWith("## ") || /^[A-Za-z][A-Za-z -]+:$/.test(trimmed)) {
      break;
    }
    const match = trimmed.match(/^-\s+(.+?)\s*$/);
    if (!match) {
      if (sawList) {
        break;
      }
      continue;
    }
    sawList = true;
    const value = cleanMarkdownListValue(match[1]);
    if (value) {
      values.push(value);
    }
  }
  return values;
}

function loadModuleInfo(root, moduleName) {
  const moduleDir = path.join(root, "modules", moduleName);
  const manifestPath = path.join(moduleDir, "module.yaml");
  const existsOnDisk = fs.existsSync(manifestPath);
  const info = {
    module: moduleName,
    exists: existsOnDisk,
    path: rel(root, moduleDir),
    manifest: rel(root, manifestPath),
    category: null,
    status: null,
    summary: null,
    decisions: [],
    owns: {
      entities: [],
      data: [],
      permissions: [],
    },
    public_api: {
      commands: [],
      queries: [],
    },
    events: {
      publishes: [],
      subscribes: [],
    },
    dependencies: {
      allowed: [],
      forbidden: [],
    },
    invariants: [],
    generated: {
      files: [],
      directories: [],
      immutable_to_non_system_agents: true,
      override_permission: "generated_file_override",
    },
    tests: {
      required: [],
    },
  };

  if (!existsOnDisk) {
    return info;
  }

  const manifest = readText(manifestPath);
  info.category = firstScalar(manifest, "category");
  info.status = firstScalar(manifest, "status");
  info.summary = firstScalar(manifest, "summary");
  info.decisions = listAfterKey(manifest, "decisions");
  info.owns.entities = listAfterPath(manifest, ["owns", "entities"]);
  info.owns.data = listAfterPath(manifest, ["owns", "data"]);
  info.owns.permissions = listAfterPath(manifest, ["owns", "permissions"]);
  info.public_api.commands = listAfterPath(manifest, ["public_api", "commands"]);
  info.public_api.queries = listAfterPath(manifest, ["public_api", "queries"]);
  info.events.publishes = listAfterPath(manifest, ["events", "publishes"]);
  info.events.subscribes = listAfterPath(manifest, ["events", "subscribes"]);
  info.dependencies.allowed = listAfterPath(manifest, ["dependencies", "allowed"]);
  info.dependencies.forbidden = listAfterPath(manifest, ["dependencies", "forbidden"]);
  info.invariants = listAfterKey(manifest, "invariants");
  info.generated.files = listAfterPath(manifest, ["generated", "files"]);
  info.generated.directories = listAfterPath(manifest, ["generated", "directories"]);
  info.tests.required = listAfterPath(manifest, ["tests", "required"]);

  return info;
}

function loadRuleCatalog(root) {
  const catalogPath = path.join(root, "rules", "check-rules.json");
  const catalog = JSON.parse(readText(catalogPath));
  return {
    path: rel(root, catalogPath),
    catalog,
  };
}

function inspectModule(root, moduleName) {
  checkName(moduleName, "module", /^[a-z][a-z0-9_]*$/, "snake_case");
  printJson({
    schema_version: "0.1",
    kind: "module_inspection",
    project: "vibit",
    module: loadModuleInfo(root, moduleName),
  });
}

function parseBoundaryArgs(args) {
  const parsed = { from: null, to: null };
  for (let i = 0; i < args.length; i += 1) {
    const arg = args[i];
    if (arg === "--from") {
      parsed.from = args[i + 1] || null;
      i += 1;
    } else if (arg === "--to") {
      parsed.to = args[i + 1] || null;
      i += 1;
    } else {
      return null;
    }
  }
  return parsed.from && parsed.to ? parsed : null;
}

function parseInspectRulesArgs(args) {
  const parsed = { category: null };
  for (let i = 0; i < args.length; i += 1) {
    const arg = args[i];
    if (arg === "--category") {
      parsed.category = args[i + 1] || null;
      i += 1;
    } else {
      return null;
    }
  }
  if (parsed.category && !/^[a-z][a-z0-9_-]*$/.test(parsed.category)) {
    return null;
  }
  return parsed;
}

function parseInspectContractArgs(args) {
  const parsed = { module: null, type: null, id: null };
  for (let i = 0; i < args.length; i += 1) {
    const arg = args[i];
    if (arg === "--module") {
      parsed.module = args[i + 1] || null;
      i += 1;
    } else if (arg === "--type") {
      parsed.type = args[i + 1] || null;
      i += 1;
    } else if (arg === "--id") {
      parsed.id = args[i + 1] || null;
      i += 1;
    } else {
      return null;
    }
  }
  if (!parsed.module || !/^[a-z][a-z0-9_]*$/.test(parsed.module)) {
    return null;
  }
  if (!parsed.type || !normalizeContractType(parsed.type)) {
    return null;
  }
  if (!parsed.id || !/^[A-Za-z][A-Za-z0-9_]*$/.test(parsed.id)) {
    return null;
  }
  return parsed;
}

function normalizeContractType(value) {
  const normalized = {
    command: "commands",
    commands: "commands",
    query: "queries",
    queries: "queries",
    event: "events",
    events: "events",
    error: "errors",
    errors: "errors",
    permission: "permissions",
    permissions: "permissions",
  };
  return normalized[value] || null;
}

function singularContractType(contractType) {
  const singular = {
    commands: "command",
    queries: "query",
    events: "event",
    errors: "error",
    permissions: "permission",
  };
  return singular[contractType] || contractType;
}

function expectedContractKind(contractType) {
  const expected = {
    commands: "command",
    queries: "query",
    events: "event",
    errors: "error_catalog",
    permissions: "permission_catalog",
  };
  return expected[contractType] || null;
}

function inspectBoundary(root, fromModule, toModule) {
  checkName(fromModule, "from module", /^[a-z][a-z0-9_]*$/, "snake_case");
  checkName(toModule, "to module", /^[a-z][a-z0-9_]*$/, "snake_case");

  const fromInfo = loadModuleInfo(root, fromModule);
  const toInfo = loadModuleInfo(root, toModule);
  const allowed = fromInfo.dependencies.allowed.includes(toModule);
  const forbidden = fromInfo.dependencies.forbidden.includes(toModule);

  printJson({
    schema_version: "0.1",
    kind: "boundary_inspection",
    project: "vibit",
    from: {
      module: fromModule,
      exists: fromInfo.exists,
      manifest: fromInfo.manifest,
    },
    to: {
      module: toModule,
      exists: toInfo.exists,
      manifest: toInfo.manifest,
    },
    dependency: {
      allowed,
      forbidden,
      declared: allowed || forbidden,
      status: forbidden ? "forbidden" : allowed ? "allowed" : "undeclared",
    },
    guidance: forbidden
      ? "Do not depend on the target module."
      : allowed
        ? "Dependency is declared as allowed."
        : "Dependency is undeclared; update manifests or ask before coupling modules.",
  });
}

function loadContractInspection(root, moduleName, requestedType, contractId) {
  const contractType = normalizeContractType(requestedType);
  const registryPath = ".arch/contracts.yaml";
  const registryExists = isFile(root, registryPath);
  const registry = registryExists ? readText(path.join(root, registryPath)) : "";
  const entries = registryExists ? parseContractEntries(registry, moduleName, contractType) : [];
  const entry = entries.find((item) => item.id === contractId) || null;

  const moduleInfo = loadModuleInfo(root, moduleName);
  const moduleManifestExists = isFile(root, moduleInfo.manifest);
  const moduleManifest = moduleManifestExists ? readText(path.join(root, moduleInfo.manifest)) : "";
  const sourceExists = entry && entry.path ? isFile(root, entry.path) : false;
  const sourceText = sourceExists ? readText(path.join(root, entry.path)) : "";
  const manifestReferencesSource = entry && entry.path ? moduleManifest.includes(entry.path) : false;
  const manifestDeclaresId = contractType === "commands"
    ? moduleInfo.public_api.commands.includes(contractId)
    : contractType === "queries"
      ? moduleInfo.public_api.queries.includes(contractId)
      : contractType === "events"
        ? moduleInfo.events.publishes.includes(contractId)
        : manifestReferencesSource;

  const expectedKind = expectedContractKind(contractType);
  const source = {
    exists: sourceExists,
    path: entry ? entry.path : null,
    schema_version: sourceExists ? firstScalar(sourceText, "schema_version") : null,
    kind: sourceExists ? firstScalar(sourceText, "kind") : null,
    module: sourceExists ? firstScalar(sourceText, "module") : null,
    name: sourceExists ? firstScalar(sourceText, "name") : null,
    status: sourceExists ? firstScalar(sourceText, "status") : null,
    summary: sourceExists ? firstScalar(sourceText, "summary") : null,
    permission: sourceExists ? firstScalar(sourceText, "permission") : null,
    version: sourceExists ? firstScalar(sourceText, "version") : null,
    runtime_status: sourceExists ? firstScalar(sourceText, "runtime_status") : null,
    decision_refs: sourceExists ? listAfterKey(sourceText, "decision_refs") : [],
    emits: sourceExists ? listAfterKey(sourceText, "emits") : [],
    errors: sourceExists && contractType === "errors" ? [] : sourceExists ? listAfterKey(sourceText, "errors") : [],
    error_codes: sourceExists ? listItemFieldAfterKey(sourceText, "errors", "code") : [],
    permission_ids: sourceExists ? listItemFieldAfterKey(sourceText, "permissions", "id") : [],
    invariants: sourceExists ? listAfterKey(sourceText, "invariants") : [],
    generated_outputs: sourceExists ? listAfterPath(sourceText, ["implementation", "generated_outputs"]) : [],
  };

  const consistency = {
    registered: Boolean(entry),
    source_exists: sourceExists,
    source_under_module: Boolean(entry && entry.path && entry.path.startsWith(`contracts/${moduleName}/`)),
    kind_matches: sourceExists && source.kind === expectedKind,
    module_matches: sourceExists && source.module === moduleName,
    id_matches: ["commands", "queries", "events"].includes(contractType)
      ? sourceExists && source.name === contractId
      : Boolean(entry),
    module_manifest_exists: moduleManifestExists,
    module_manifest_declares_id: manifestDeclaresId,
    module_manifest_references_source: manifestReferencesSource,
  };

  consistency.status = Object.values(consistency).every(Boolean) ? "consistent" : "incomplete";

  return {
    request: {
      module: moduleName,
      type: singularContractType(contractType),
      normalized_type: contractType,
      id: contractId,
    },
    registry: {
      exists: registryExists,
      path: registryPath,
      entry,
    },
    source,
    module_manifest: {
      exists: moduleManifestExists,
      path: moduleInfo.manifest,
      declares_id: manifestDeclaresId,
      references_source: manifestReferencesSource,
    },
    consistency,
    guidance: consistency.status === "consistent"
      ? "Contract is registered, sourced, and declared by the module manifest."
      : "Run `node tools/vibit check contracts --json` for full consistency failures before generating or implementing this contract.",
  };
}

function inspectContract(root, options) {
  const contractType = normalizeContractType(options.type);
  const inspection = loadContractInspection(root, options.module, contractType, options.id);
  if (!inspection.registry.entry) {
    console.error(`Unknown ${singularContractType(contractType)} contract ${options.module}:${options.id}`);
    process.exit(1);
  }
  printJson({
    schema_version: "0.1",
    kind: "contract_inspection",
    project: "vibit",
    contract: inspection,
  });
}

function inspectRule(root, ruleId) {
  checkName(ruleId, "rule-id", /^[a-z][a-z0-9_.-]*$/, "dotted rule id");
  const { path: catalogPath, catalog } = loadRuleCatalog(root);
  const rule = Array.isArray(catalog.rules)
    ? catalog.rules.find((item) => item.rule_id === ruleId)
    : null;
  if (!rule) {
    console.error(`Unknown rule_id: ${ruleId}`);
    process.exit(1);
  }
  printJson({
    schema_version: "0.1",
    kind: "rule_inspection",
    project: "vibit",
    catalog: {
      name: catalog.catalog,
      path: catalogPath,
      status: catalog.status,
    },
    rule,
  });
}

function inspectRules(root, options) {
  const { path: catalogPath, catalog } = loadRuleCatalog(root);
  const allRules = Array.isArray(catalog.rules) ? catalog.rules : [];
  const rules = options.category
    ? allRules.filter((rule) => rule.category === options.category)
    : allRules;
  printJson({
    schema_version: "0.1",
    kind: "rules_inspection",
    project: "vibit",
    catalog: {
      name: catalog.catalog,
      path: catalogPath,
      status: catalog.status,
    },
    filter: {
      category: options.category,
    },
    count: rules.length,
    rules,
  });
}

function loadChangeInfo(root, changeId) {
  const dir = changeDirectory(root, changeId);
  const specPath = path.join(dir, "spec.yaml");
  const existsOnDisk = fs.existsSync(dir) && fs.statSync(dir).isDirectory();
  const specExists = fs.existsSync(specPath) && fs.statSync(specPath).isFile();
  const files = {};
  for (const file of CHANGE_SPEC_REQUIRED_FILES) {
    const target = path.join(dir, file);
    files[file] = fs.existsSync(target) && fs.statSync(target).isFile();
  }

  const change = {
    change_id: changeId,
    declared_change_id: null,
    exists: existsOnDisk,
    path: rel(root, dir),
    spec: rel(root, specPath),
    spec_exists: specExists,
    date: null,
    type: null,
    status: null,
    summary: null,
    affected_modules: [],
    verification: {
      required: [],
      status: null,
    },
    files,
  };

  if (specExists) {
    const spec = readText(specPath);
    change.declared_change_id = firstScalar(spec, "change_id");
    change.date = firstScalar(spec, "date");
    change.type = firstScalar(spec, "type");
    change.status = firstScalar(spec, "status");
    change.summary = firstScalar(spec, "summary");
    change.affected_modules = listAfterKey(spec, "affected_modules");
    change.verification.required = listAfterPath(spec, ["verification", "required"]);
    change.verification.status = firstScalar(sectionBody(spec, "verification").join("\n"), "status");
  }

  return change;
}

function inspectChange(root, changeId) {
  checkName(changeId, "change-id", /^[a-z0-9][a-z0-9-]*[a-z0-9]$/, "kebab-case");

  printJson({
    schema_version: "0.1",
    kind: "change_inspection",
    project: "vibit",
    change: loadChangeInfo(root, changeId),
  });
}

function discoverConversationFiles(root) {
  const dir = path.join(root, "conversations");
  if (!fs.existsSync(dir)) {
    return [];
  }
  return fs.readdirSync(dir)
    .filter((name) => name.endsWith(".md"))
    .filter((name) => !["README.md", "README.zh-CN.md"].includes(name))
    .sort()
    .map((name) => path.join(dir, name));
}

function loadConversationInfo(root, filePath) {
  const text = readText(filePath);
  const heading = firstMarkdownHeading(text) || path.basename(filePath, ".md");
  return {
    conversation_id: path.basename(filePath, ".md"),
    title: heading.replace(/^Conversation:\s*/, ""),
    date: firstMarkdownField(text, "Date"),
    path: rel(root, filePath),
    related_changes: markdownListAfterLabel(text, "Related changes"),
    related_artifacts: markdownListAfterLabel(text, "Related artifacts"),
  };
}

function discoverDecisionFiles(root) {
  const dir = path.join(root, "decisions");
  if (!fs.existsSync(dir)) {
    return [];
  }
  return fs.readdirSync(dir)
    .filter((name) => /^ADR-\d{4}-.*\.md$/.test(name))
    .sort()
    .map((name) => path.join(dir, name));
}

function loadDecisionInfo(root, filePath) {
  const text = readText(filePath);
  const fileName = path.basename(filePath, ".md");
  const heading = firstMarkdownHeading(text) || fileName;
  const decisionIdMatch = heading.match(/^(ADR-\d{4})/);
  return {
    decision_id: decisionIdMatch ? decisionIdMatch[1] : fileName,
    title: heading.replace(/^ADR-\d{4}:\s*/, ""),
    status: firstMarkdownField(text, "Status"),
    date: firstMarkdownField(text, "Date"),
    path: rel(root, filePath),
    related_changes: markdownListAfterLabel(text, "Related changes"),
    related_conversations: markdownListAfterLabel(text, "Related conversations"),
    related_artifacts: markdownListAfterLabel(text, "Related artifacts"),
  };
}

function inspectMemory(root) {
  const changes = discoverChangeIds(root).map((changeId) => loadChangeInfo(root, changeId));
  const conversations = discoverConversationFiles(root).map((filePath) => loadConversationInfo(root, filePath));
