  return keys;
}

function contractSourceFieldSummary(sourceText, contractType) {
  if (!sourceText) {
    return {
      input_required: [],
      input_properties: [],
      output_required: [],
      output_properties: [],
      payload_required: [],
      payload_properties: [],
    };
  }

  const summary = {
    input_required: yamlListValuesAtPath(sourceText, ["input", "required"]),
    input_properties: yamlMapKeysAtPath(sourceText, ["input", "properties"]),
    output_required: yamlListValuesAtPath(sourceText, ["output", "required"]),
    output_properties: yamlMapKeysAtPath(sourceText, ["output", "properties"]),
    payload_required: yamlListValuesAtPath(sourceText, ["payload", "required"]),
