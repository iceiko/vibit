function checkSchemas(root) {
  resetResults("check schemas");
  if (!jsonOutput) {
    console.log(`Checking schemas in ${root}\n`);
  }

  requireSchemaShape(root, "schema/module-manifest.schema.json", "vibit Module Manifest");
  requireSchemaShape(root, "schema/change-spec.schema.json", "vibit Change Spec");
  requireSchemaShape(root, "schema/agent-decision-record.schema.json", "vibit Agent Decision Record");
  requireSchemaShape(root, "schema/inspect-output.schema.json", "vibit Inspect Output");
  requireSchemaShape(root, "schema/rule-catalog.schema.json", "vibit Rule Catalog");
  requireRuleCatalog(root, "rules/check-rules.json", "check_rules", KNOWN_CHECK_RULE_IDS);

  checkTextIncludes(root, ".arch/conventions.yaml", "schema_validation_standard:");
  checkTextIncludes(root, ".arch/conventions.yaml", "schemas:");

  for (const moduleName of discoverRegisteredModules(root)) {
    const manifestPath = `modules/${moduleName}/module.yaml`;
    if (!isFile(root, manifestPath)) {
      fail(`${manifestPath} is missing`);
      continue;
    }
    const text = readText(path.join(root, manifestPath));
    requireScalarValue(text, manifestPath, "schema_version", ["0.1"]);
    const declaredModule = requireScalarValue(text, manifestPath, "module", null);
    if (declaredModule === moduleName) {
      ok(`${manifestPath} module matches registry`);
    } else {
      fail(`${manifestPath} module does not match registry name ${moduleName}`);
    }
    requireScalarValue(text, manifestPath, "category", ["domain", "platform", "integration", "application"]);
    requireScalarValue(text, manifestPath, "status", ["draft", "active", "deprecated", "removed"]);
    for (const key of ["summary:", "owns:", "public_api:", "events:", "dependencies:", "generated:", "tests:"]) {
      if (text.includes(key)) {
        ok(`${manifestPath} contains ${key}`);
      } else {
        fail(`${manifestPath} is missing ${key}`);
      }
    }
  }

  for (const changeId of discoverChangeIds(root)) {
    const dir = changeDirectory(root, changeId);
    const specPath = path.join(dir, "spec.yaml");
    const relativeSpec = rel(root, specPath);
    if (!fs.existsSync(specPath)) {
      fail(`${relativeSpec} is missing`);
      continue;
    }
    const text = readText(specPath);
    requireScalarValue(text, relativeSpec, "schema_version", ["0.1"]);
    const declaredChange = requireScalarValue(text, relativeSpec, "change_id", null);
    if (declaredChange === changeId) {
      ok(`${relativeSpec} change_id matches directory`);
    } else {
      fail(`${relativeSpec} change_id does not match ${changeId}`);
    }
    requireScalarValue(text, relativeSpec, "type", ["feature", "bugfix", "migration", "refactor", "standard", "contract", "protocol", "docs", "tooling"]);
    requireScalarValue(text, relativeSpec, "status", ["draft", "active", "verified", "accepted", "deprecated"]);
    const verificationStatus = firstScalar(sectionBody(text, "verification").join("\n"), "status");
    if (verificationStatus && ["Verified", "Not verified", "Not applicable"].includes(verificationStatus)) {
      ok(`${relativeSpec} verification status is ${verificationStatus}`);
    } else {
      fail(`${relativeSpec} verification status is invalid or missing`);
    }
  }

  const decisionDir = path.join(root, "decisions");
  if (fs.existsSync(decisionDir)) {
    const decisions = fs.readdirSync(decisionDir)
      .filter((name) => /^ADR-\d{4}-.*\.md$/.test(name))
      .sort();
    for (const decision of decisions) {
      requireMarkdownSections(root, `decisions/${decision}`, [
        "Context",
        "Decision",
        "Alternatives Considered",
        "Rationale",
        "Agent Reasoning Summary",
        "Decision Weights",
        "Consequences",
        "Reversal Conditions",
        "Follow-Up",
      ]);
    }
  }

  finish();
}

function checkMemory(root) {
  resetResults("check memory");
  if (!jsonOutput) {
    console.log(`Checking project memory in ${root}\n`);
  }

  const conversations = discoverConversationFiles(root).map((filePath) => rel(root, filePath));
  const decisions = discoverDecisionFiles(root).map((filePath) => rel(root, filePath));

  if (conversations.length > 0) {
    ok(`conversations has at least one log`, {
      rule_id: "artifact.minimum_count",
      artifact: "conversations",
    });
  } else {
    fail(`conversations has no logs`, {
      rule_id: "artifact.minimum_count",
      artifact: "conversations",
    });
  }

  if (decisions.length > 0) {
    ok(`decisions has at least one ADR`, {
      rule_id: "artifact.minimum_count",
      artifact: "decisions",
    });
  } else {
    fail(`decisions has no ADRs`, {
      rule_id: "artifact.minimum_count",
      artifact: "decisions",
    });
  }

  const decisionIds = new Map();
  for (const conversation of conversations) {
    requireMarkdownHeading(root, conversation, "Conversation:");
    requireMarkdownField(root, conversation, "Date");
    requireMarkdownSections(root, conversation, [
      "Context",
      "Maintainer Narrative",
      "Agent Response Summary",
      "Decisions",
      "Artifacts",
      "Open Questions",
      "Follow-Up",
      "Redaction Notes",
    ]);
  }

  for (const decision of decisions) {
    const heading = requireMarkdownHeading(root, decision, "ADR-");
    const idFromFile = path.basename(decision).match(/^(ADR-\d{4})-/);
    if (idFromFile) {
      const decisionId = idFromFile[1];
      if (!decisionIds.has(decisionId)) {
        decisionIds.set(decisionId, []);
      }
      decisionIds.get(decisionId).push(decision);
    }
    if (heading && idFromFile && heading.startsWith(idFromFile[1])) {
      ok(`${decision} heading matches file id`);
    } else if (idFromFile) {
      fail(`${decision} heading does not match file id ${idFromFile[1]}`);
    }
    requireMarkdownField(root, decision, "Status");
    requireMarkdownField(root, decision, "Date");
    requireMarkdownSections(root, decision, [
      "Context",
      "Decision",
      "Alternatives Considered",
      "Rationale",
      "Agent Reasoning Summary",
      "Decision Weights",
      "Consequences",
      "Reversal Conditions",
      "Follow-Up",
    ]);
  }

  for (const [decisionId, files] of decisionIds.entries()) {
    if (files.length === 1) {
      ok(`${decisionId} is unique`, {
        rule_id: "markdown.unique_id",
        artifact: files[0],
      });
    } else {
      fail(`${decisionId} is used by multiple ADR files: ${files.join(", ")}`, {
        rule_id: "markdown.unique_id",
        artifact: files[0],
      });
    }
  }

  finish({
    summary_counts: {
      conversations: conversations.length,
      decisions: decisions.length,
    },
  });
}

function checkContractSource(root, moduleName, contractType, expectedKind, entry, moduleInfo, moduleManifest) {
  const artifact = entry.path || `${moduleName}:${contractType}:${entry.id || "missing-id"}`;
  if (!entry.id) {
    fail(`${artifact} contract entry is missing id`, {
      rule_id: "contract.registry_entry",
      artifact,
    });
    return;
  }
  if (!entry.path) {
    fail(`${moduleName} ${contractType} ${entry.id} contract entry is missing path`, {
      rule_id: "contract.registry_entry",
      artifact,
    });
    return;
  }
  if (isProtoBackedStorageContractEntry({ ...entry, module: moduleName, normalized_type: contractType })) {
    if (isFile(root, entry.path)) {
      ok(`${entry.path} exists`, {
        rule_id: "contract.source_exists",
        artifact: entry.path,
      });
    } else {
      fail(`${entry.path} is missing`, {
        rule_id: "contract.source_exists",
        artifact: entry.path,
      });
      return;
    }

    const protoText = readText(path.join(root, entry.path));
    const requestMessage = `${entry.id}Request`;
    const responseMessage = `${entry.id}Response`;
    for (const marker of [
      "package vibit.storage.v1;",
      `message ${requestMessage}`,
      `message ${responseMessage}`,
      "@source decisions/ADR-0119-storage-objects-protocol-route-implementation.md",
    ]) {
      checkRequiredText(root, entry.path, marker, "contract.source_match", marker);
    }
    if (/owner_id|player_id|session_id|access_token|lookup_digest|verifier_digest|s3_bucket/i.test(protoText)) {
      fail(`${entry.path} includes forbidden storage protocol proof or compatibility fields`, {
        rule_id: "contract.source_match",
        artifact: entry.path,
      });
    } else {
      ok(`${entry.path} keeps storage protocol route payload owner/proof neutral`, {
        rule_id: "contract.source_match",
        artifact: entry.path,
      });
    }
    return;
  }
  if (!pathStartsWith(entry.path, `contracts/${moduleName}/`)) {
    fail(`${entry.path} is outside contracts/${moduleName}/`, {
      rule_id: "contract.registry_entry",
      artifact: entry.path,
    });
  } else {
    ok(`${entry.path} is under contracts/${moduleName}/`, {
      rule_id: "contract.registry_entry",
      artifact: entry.path,
    });
  }
  if (isFile(root, entry.path)) {
    ok(`${entry.path} exists`, {
      rule_id: "contract.source_exists",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} is missing`, {
      rule_id: "contract.source_exists",
      artifact: entry.path,
    });
    return;
  }

  const text = readText(path.join(root, entry.path));
  const schemaVersion = firstScalar(text, "schema_version");
  if (schemaVersion === "0.1") {
    ok(`${entry.path} declares schema_version: 0.1`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} is missing schema_version: 0.1`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  }
  const kind = firstScalar(text, "kind");
  if (kind === expectedKind) {
    ok(`${entry.path} kind is ${expectedKind}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} kind does not match ${expectedKind}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  }
  const module = firstScalar(text, "module");
  if (module === moduleName) {
    ok(`${entry.path} module is ${moduleName}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} module does not match ${moduleName}`, {
      rule_id: "contract.source_match",
      artifact: entry.path,
    });
  }
  const status = firstScalar(text, "status");
  if (["draft", "active", "deprecated"].includes(status)) {
    ok(`${entry.path} status is ${status}`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  } else {
    fail(`${entry.path} status is invalid or missing`, {
      rule_id: "contract.source_field",
      artifact: entry.path,
    });
  }

  if (["commands", "queries", "events"].includes(contractType)) {
    const name = firstScalar(text, "name");
    if (name === entry.id) {
      ok(`${entry.path} name matches registry id ${entry.id}`, {
        rule_id: "contract.source_match",
        artifact: entry.path,
      });
    } else {
      fail(`${entry.path} name does not match registry id ${entry.id}`, {
        rule_id: "contract.source_match",
        artifact: entry.path,
      });
    }
  }

  const declared = {
    commands: moduleInfo.public_api.commands,
    queries: moduleInfo.public_api.queries,
    events: moduleInfo.events.publishes,
  };
  if (declared[contractType]) {
    if (declared[contractType].includes(entry.id)) {
      ok(`${entry.id} is declared by modules/${moduleName}/module.yaml`, {
        rule_id: "contract.source_match",
        artifact: `modules/${moduleName}/module.yaml`,
      });
    } else {
      fail(`${entry.id} is not declared by modules/${moduleName}/module.yaml`, {
        rule_id: "contract.source_match",
        artifact: `modules/${moduleName}/module.yaml`,
      });
    }
  }

  if (moduleManifest.includes(entry.path)) {
    ok(`modules/${moduleName}/module.yaml references ${entry.path}`, {
      rule_id: "contract.source_match",
      artifact: `modules/${moduleName}/module.yaml`,
    });
  } else {
    fail(`modules/${moduleName}/module.yaml does not reference ${entry.path}`, {
      rule_id: "contract.source_match",
      artifact: `modules/${moduleName}/module.yaml`,
    });
  }
}

function runtimeContractFamilyBlock(registry, familyName) {
  const lines = registry.split(/\r?\n/);
  const familyIndex = lines.findIndex((line) => line.trim() === `${familyName}:`);
  if (familyIndex === -1) {
    return "";
  }

  const familyMatch = lines[familyIndex].match(/^(\s*)/);
  const familyIndent = familyMatch ? familyMatch[1].length : 0;
  const block = [lines[familyIndex]];

  for (let i = familyIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (!line.trim()) {
      block.push(line);
      continue;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= familyIndent) {
      break;
    }
    block.push(line);
  }

  return block.join("\n");
}

