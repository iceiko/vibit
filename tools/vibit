function inspectGenerated(root, options = { module: null, type: null }) {
  const protoRoot = "runtime/internal/generated/proto";
  const contractRoot = "runtime/internal/generated/contracts";
  const protoFiles = isDirectory(root, protoRoot)
    ? discoverFilesUnder(root, protoRoot).filter((file) => path.basename(file) !== ".gitkeep")
    : [];
  const allContractFiles = isDirectory(root, contractRoot)
    ? discoverFilesUnder(root, contractRoot).filter((file) => path.basename(file) !== ".gitkeep")
    : [];
  const contractFiles = allContractFiles.filter((file) => {
    if (options.module && !pathStartsWith(file, `${contractRoot}/${options.module}/`)) {
      return false;
    }
    if (options.type && !file.includes(`/${options.type}/`)) {
      return false;
    }
    return true;
  });
  const expectedContractShapes = discoverContractRegistryEntries(root)
    .filter((entry) => isGeneratedContractShapeEntry(entry))
    .filter((entry) => !options.module || entry.module === options.module)
    .filter((entry) => !options.type || entry.normalized_type === options.type)
    .map((entry) => ({
      module: entry.module,
      family: entry.family || null,
      type: entry.type,
      normalized_type: entry.normalized_type,
      id: entry.id,
      source: entry.path,
      output: generatedContractShapePath(entry),
      exists: isFile(root, generatedContractShapePath(entry)),
    }));
  const expectedContractShapeOutputs = new Set(expectedContractShapes.map((item) => item.output));
  const staleContractShapeFiles = contractFiles.filter((file) => !expectedContractShapeOutputs.has(file));
  const missingContractShapes = expectedContractShapes.filter((item) => !item.exists);
  const contractShapeStatus = missingContractShapes.length > 0
    ? "missing"
    : staleContractShapeFiles.length > 0
      ? "stale"
      : "complete";

  printJson({
    schema_version: "0.1",
    kind: "generated_inspection",
    project: "vibit",
    roots: {
      proto: {
        path: protoRoot,
        exists: isDirectory(root, protoRoot),
        files: protoFiles,
      },
      contracts: {
        path: contractRoot,
        exists: isDirectory(root, contractRoot),
        files: contractFiles,
      },
    },
    filter: {
      module: options.module,
      type: options.type ? singularContractType(options.type) : null,
      normalized_type: options.type,
    },
    expected_contract_shapes: expectedContractShapes,
    missing_contract_shapes: missingContractShapes,
    stale_contract_shape_files: staleContractShapeFiles,
    contract_shape_status: contractShapeStatus,
    summary: {
      proto_files: protoFiles.length,
      contract_shape_files: contractFiles.length,
      all_contract_shape_files: allContractFiles.length,
      expected_contract_shapes: expectedContractShapes.length,
      missing_contract_shapes: missingContractShapes.length,
      stale_contract_shape_files: staleContractShapeFiles.length,
      contract_shape_status: contractShapeStatus,
    },
  });
}

function inspectRule(root, ruleId) {
  checkName(ruleId, "rule-id", /^[a-z][a-z0-9_.-]*$/, "dotted rule id");
  const { path: catalogPath, catalog } = loadRuleCatalog(root);
  const rule = Array.isArray(catalog.rules)
    ? catalog.rules.find((item) => item.rule_id === ruleId)
    : null;
  if (!rule) {
    console.error(`Unknown rule_id: ${ruleId}`);
    process.exit(1);
  }
  printJson({
    schema_version: "0.1",
    kind: "rule_inspection",
    project: "vibit",
    catalog: {
      name: catalog.catalog,
