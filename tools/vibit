function checkSchemas(root) {
  resetResults("check schemas");
  if (!jsonOutput) {
    console.log(`Checking schemas in ${root}\n`);
  }

  requireSchemaShape(root, "schema/module-manifest.schema.json", "vibit Module Manifest");
  requireSchemaShape(root, "schema/change-spec.schema.json", "vibit Change Spec");
  requireSchemaShape(root, "schema/agent-decision-record.schema.json", "vibit Agent Decision Record");
  requireSchemaShape(root, "schema/inspect-output.schema.json", "vibit Inspect Output");
  requireSchemaShape(root, "schema/rule-catalog.schema.json", "vibit Rule Catalog");
  requireRuleCatalog(root, "rules/check-rules.json", "check_rules", KNOWN_CHECK_RULE_IDS);

  checkTextIncludes(root, ".arch/conventions.yaml", "schema_validation_standard:");
  checkTextIncludes(root, ".arch/conventions.yaml", "schemas:");

  for (const moduleName of discoverRegisteredModules(root)) {
    const manifestPath = `modules/${moduleName}/module.yaml`;
    if (!isFile(root, manifestPath)) {
      fail(`${manifestPath} is missing`);
      continue;
    }
    const text = readText(path.join(root, manifestPath));
    requireScalarValue(text, manifestPath, "schema_version", ["0.1"]);
    const declaredModule = requireScalarValue(text, manifestPath, "module", null);
    if (declaredModule === moduleName) {
      ok(`${manifestPath} module matches registry`);
    } else {
      fail(`${manifestPath} module does not match registry name ${moduleName}`);
    }
    requireScalarValue(text, manifestPath, "category", ["domain", "platform", "integration", "application"]);
    requireScalarValue(text, manifestPath, "status", ["draft", "active", "deprecated", "removed"]);
    for (const key of ["summary:", "owns:", "public_api:", "events:", "dependencies:", "generated:", "tests:"]) {
      if (text.includes(key)) {
        ok(`${manifestPath} contains ${key}`);
      } else {
        fail(`${manifestPath} is missing ${key}`);
      }
    }
  }

  for (const changeId of discoverChangeIds(root)) {
    const dir = changeDirectory(root, changeId);
    const specPath = path.join(dir, "spec.yaml");
    const relativeSpec = rel(root, specPath);
    if (!fs.existsSync(specPath)) {
      fail(`${relativeSpec} is missing`);
      continue;
    }
    const text = readText(specPath);
    requireScalarValue(text, relativeSpec, "schema_version", ["0.1"]);
    const declaredChange = requireScalarValue(text, relativeSpec, "change_id", null);
    if (declaredChange === changeId) {
      ok(`${relativeSpec} change_id matches directory`);
    } else {
      fail(`${relativeSpec} change_id does not match ${changeId}`);
    }
    requireScalarValue(text, relativeSpec, "type", ["feature", "bugfix", "migration", "refactor", "standard", "docs", "tooling"]);
    requireScalarValue(text, relativeSpec, "status", ["draft", "active", "verified", "accepted", "deprecated"]);
    const verificationStatus = firstScalar(sectionBody(text, "verification").join("\n"), "status");
    if (verificationStatus && ["Verified", "Not verified", "Not applicable"].includes(verificationStatus)) {
      ok(`${relativeSpec} verification status is ${verificationStatus}`);
    } else {
      fail(`${relativeSpec} verification status is invalid or missing`);
    }
  }

  const decisionDir = path.join(root, "decisions");
  if (fs.existsSync(decisionDir)) {
    const decisions = fs.readdirSync(decisionDir)
      .filter((name) => /^ADR-\d{4}-.*\.md$/.test(name))
      .sort();
    for (const decision of decisions) {
      requireMarkdownSections(root, `decisions/${decision}`, [
        "Context",
        "Decision",
        "Alternatives Considered",
        "Rationale",
        "Agent Reasoning Summary",
        "Decision Weights",
        "Consequences",
        "Reversal Conditions",
        "Follow-Up",
      ]);
    }
  }

  finish();
}

