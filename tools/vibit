function checkRuntimeImportBoundaries(root, goFiles) {
  const importRules = [
    {
      importPath: "github.com/coder/websocket",
      allowedPrefixes: ["runtime/internal/platform/transport/ws/"],
      description: "WebSocket dependency",
    },
    {
      importPath: "github.com/jackc/pgx/v5",
      allowedPrefixes: ["runtime/internal/platform/persistence/postgres/"],
      description: "PostgreSQL dependency",
    },
    {
      importPath: "github.com/pressly/goose/v3",
      allowedPrefixes: ["runtime/internal/platform/migrations/"],
      description: "migration dependency",
    },
    {
      importPath: "google.golang.org/protobuf",
      allowedPrefixes: [
        "runtime/internal/generated/proto/",
        "runtime/internal/platform/protocol/protobuf/",
      ],
      description: "Protobuf runtime dependency",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/generated/proto",
      allowedPrefixes: [
        "runtime/internal/generated/proto/",
        "runtime/internal/platform/protocol/protobuf/",
      ],
      description: "generated Protobuf package",
    },
  ];

  for (const file of goFiles) {
    const text = readText(path.join(root, file));
    for (const rule of importRules) {
      if (!text.includes(`"${rule.importPath}`)) {
        continue;
      }
      const allowed = rule.allowedPrefixes.some((prefix) => pathStartsWith(file, prefix));
      if (allowed) {
        ok(`${file} imports ${rule.description} inside allowed boundary`, {
          rule_id: "runtime.import_boundary",
          artifact: file,
        });
      } else {
        fail(`${file} imports ${rule.description} outside allowed boundary`, {
          rule_id: "runtime.import_boundary",
          artifact: file,
        });
      }
    }
  }
}

