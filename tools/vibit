function generateModule(root, moduleName) {
  resetResults();
  checkName(moduleName, "module", /^[a-z][a-z0-9_]*$/, "snake_case");

  const moduleDir = path.join(root, "modules", moduleName);
  console.log(`Generating module ${moduleName} at ${rel(root, moduleDir)}\n`);

  const dirs = ["commands", "queries", "events", "models", "repositories", "policies", "services", "tests"];
  for (const dir of dirs) {
    const target = path.join(moduleDir, dir);
    if (!fs.existsSync(target)) {
      fs.mkdirSync(target, { recursive: true });
      ok(`created ${rel(root, target)}/`);
    } else {
      warn(`${rel(root, target)}/ already exists`);
    }
    const keepFile = path.join(target, ".gitkeep");
    if (writeFileIfMissing(keepFile, "")) {
      ok(`created ${rel(root, keepFile)}`);
    }
  }

  const files = [
    ["module.yaml", moduleManifest(moduleName)],
    ["AGENTS.md", moduleAgents(moduleName, false)],
    ["AGENTS.zh-CN.md", moduleAgents(moduleName, true)],
  ];

  for (const [file, content] of files) {
    const target = path.join(moduleDir, file);
    if (writeFileIfMissing(target, content)) {
      ok(`created ${rel(root, target)}`);
    } else {
      warn(`${rel(root, target)} already exists`);
    }
  }

  finish();
}

function generateContractShapes(root, targetModule) {
  resetResults("generate contract-shapes");
  if (!/^(all|[a-z][a-z0-9_]*)$/.test(targetModule)) {
    fail("target must be all or snake_case module", {
      rule_id: "argument.format",
      artifact: targetModule,
    });
    finish();
    return;
  }

  const entries = discoverContractRegistryEntries(root)
    .filter((entry) => isGeneratedContractShapeEntry(entry))
    .filter((entry) => targetModule === "all" || entry.module === targetModule);

  if (entries.length === 0) {
    warn(`no contract entries found for ${targetModule}`, {
      rule_id: "generator.artifact_already_exists",
      artifact: targetModule,
    });
  }

  for (const entry of entries) {
    if (!entry.path || !isFile(root, entry.path)) {
      fail(`contract source is missing for ${entry.module}:${entry.id}`, {
        rule_id: "contract.source_exists",
        artifact: entry.path || `${entry.module}:${entry.id}`,
      });
      continue;
    }
    const result = writeGeneratedContractShape(root, entry);
    const ruleId = result.status === "created" ? "generator.created_artifact" : "generator.artifact_already_exists";
    ok(`${result.status} ${result.path}`, {
      rule_id: ruleId,
      artifact: result.path,
    });
  }

  finish({
    target: targetModule,
    summary_counts: {
      generated_contract_shapes: entries.length,
    },
  });
}

function main() {
  let args = process.argv.slice(2);
  const wantsJson = args.includes("--json");

  if (args.length === 0 || args[0] === "--help" || args[0] === "-h") {
    process.stdout.write(usage());
    return;
  }

  if (wantsJson) {
    args = args.filter((arg) => arg !== "--json");
  }

  const [group, command, value, extra] = args;

  if (wantsJson && group !== "check" && group !== "inspect") {
    console.error("--json is only supported for check commands.");
    process.exit(2);
  }

  jsonOutput = wantsJson;

  const root = findRepoRoot(process.cwd());
  if (!root) {
    console.error("Could not find vibit repository root.");
    process.exit(2);
  }

  if (group === "check" && command === "architecture" && !value) {
    checkArchitecture(root);
    return;
  }

  if (group === "check" && command === "schemas" && !value) {
    checkSchemas(root);
    return;
  }

  if (group === "check" && command === "memory" && !value) {
    checkMemory(root);
    return;
  }

  if (group === "check" && command === "contracts" && !value) {
    checkContracts(root);
    return;
  }

  if (group === "check" && command === "protocol" && !value) {
    checkProtocol(root);
    return;
  }

  if (group === "check" && command === "generated" && !value) {
    checkGenerated(root);
    return;
  }

  if (group === "check" && command === "agent-tooling" && !value) {
    checkAgentTooling(root);
    return;
  }

  if (group === "check" && command === "migrations" && !value) {
    checkMigrations(root);
    return;
  }

  if (group === "check" && command === "postgres-env" && !value) {
    checkPostgresEnv(root);
    return;
  }

  if (group === "check" && command === "runtime" && !value) {
    checkRuntime(root);
    return;
  }

  if (group === "check" && command === "work" && !value) {
    checkWork(root);
    return;
  }

  if (group === "check" && command === "all" && !value) {
    checkAll(root);
    return;
  }

  if (group === "check" && command === "change" && value) {
    checkChange(root, value);
    return;
  }

  if (group === "check" && command === "module" && value) {
    checkModule(root, value);
    return;
  }

  if (group === "generate" && command === "module" && value) {
    if (extra) {
      console.error("Too many arguments.\n");
      process.stderr.write(usage());
      process.exit(2);
    }
    generateModule(root, value);
    return;
  }

  if (group === "generate" && command === "contract-shapes" && value) {
    if (extra) {
      console.error("Too many arguments.\n");
      process.stderr.write(usage());
      process.exit(2);
    }
    generateContractShapes(root, value);
    return;
  }

  if (group === "inspect" && command === "module" && value && !extra) {
    inspectModule(root, value);
    return;
  }

  if (group === "inspect" && command === "change" && value && !extra) {
    inspectChange(root, value);
    return;
  }

  if (group === "inspect" && command === "work" && !value) {
    inspectWork(root);
    return;
  }

  if (group === "inspect" && command === "next" && !value) {
    inspectNext(root);
    return;
  }

  if (group === "inspect" && command === "generated") {
    const parsed = parseInspectGeneratedArgs(args.slice(2));
    if (!parsed) {
      console.error("Usage: vibit inspect generated [--module <module>] [--type <contract-type>]");
      process.exit(2);
    }
    inspectGenerated(root, parsed);
    return;
  }

  if (group === "inspect" && command === "reference" && !value) {
    inspectReference(root);
    return;
  }

  if (group === "inspect" && command === "memory" && !value) {
    inspectMemory(root);
    return;
  }

  if (group === "inspect" && command === "contracts") {
    const parsed = parseInspectContractsArgs(args.slice(2));
    if (!parsed) {
      console.error("Usage: vibit inspect contracts [--module <module>] [--type <contract-type>] [--status <status>]");
      process.exit(2);
    }
    inspectContracts(root, parsed);
    return;
  }

  if (group === "inspect" && command === "contract") {
    const parsed = parseInspectContractArgs(args.slice(2));
    if (!parsed) {
      console.error("Usage: vibit inspect contract --module <module> --type <type> --id <id>");
      process.exit(2);
    }
    inspectContract(root, parsed);
    return;
  }

  if (group === "inspect" && command === "rule" && value && !extra) {
    inspectRule(root, value);
    return;
  }

  if (group === "inspect" && command === "rules") {
    const parsed = parseInspectRulesArgs(args.slice(2));
    if (!parsed) {
      console.error("Usage: vibit inspect rules [--category <category>]");
      process.exit(2);
    }
    inspectRules(root, parsed);
    return;
  }

  if (group === "inspect" && command === "boundary") {
    const parsed = parseBoundaryArgs(args.slice(2));
    if (!parsed) {
      console.error("Usage: vibit inspect boundary --from <module> --to <module>");
      process.exit(2);
    }
    inspectBoundary(root, parsed.from, parsed.to);
    return;
  }

  if (extra) {
    console.error("Too many arguments.\n");
    process.stderr.write(usage());
    process.exit(2);
  }

  console.error("Unknown command.\n");
  process.stderr.write(usage());
  process.exit(2);
}

main();
