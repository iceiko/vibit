  for (const file of goFiles.filter((goFile) => !goFile.endsWith("_test.go"))) {
    if (friendsRelationshipRepositoryInterfaceImplementationCompleted(root) && pathStartsWith(file, `${forbiddenRuntimeModulePath}/`)) {
      continue;
    }
    const text = sourceWithoutGoComments(readText(path.join(root, file)));
