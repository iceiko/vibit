function checkProtoMessageShape(root, protoPath, protoText, messageName, fieldNames, ruleId = "protocol.message") {
  const messagePattern = new RegExp(`\\bmessage\\s+${messageName}\\b`);
  if (messagePattern.test(protoText)) {
    ok(`${protoPath} declares message ${messageName}`, {
      rule_id: ruleId,
      artifact: protoPath,
    });
  } else {
    fail(`${protoPath} is missing message ${messageName}`, {
      rule_id: ruleId,
      artifact: protoPath,
    });
    return;
  }

  const messageBody = protoMessageBody(protoText, messageName);
  if (messageBody === null) {
    fail(`${protoPath} has malformed message ${messageName}`, {
      rule_id: "protocol.message",
      artifact: protoPath,
    });
    return;
  }

  for (const fieldName of fieldNames) {
    const fieldPattern = new RegExp(`\\b${fieldName}\\s*=\\s*\\d+\\s*;`);
    if (fieldPattern.test(messageBody)) {
      ok(`${protoPath} ${messageName} declares field ${fieldName}`, {
        rule_id: "protocol.field",
        artifact: protoPath,
      });
    } else {
      fail(`${protoPath} ${messageName} is missing field ${fieldName}`, {
        rule_id: "protocol.field",
        artifact: protoPath,
      });
    }
  }
}

function checkProtoEnumValues(root, protoPath, protoText, enumName, values) {
  const enumPattern = new RegExp(`\\benum\\s+${enumName}\\s*\\{`, "m");
  const enumMatch = enumPattern.exec(protoText);
  if (!enumMatch) {
    fail(`${protoPath} is missing enum ${enumName}`, {
