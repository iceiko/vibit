      artifact: "contracts",
    });
  } else {
    fail("contracts/ is missing", {
      rule_id: "artifact.directory_exists",
      artifact: "contracts",
    });
  }

  const registry = readText(path.join(root, registryPath));
  requireScalarValue(registry, registryPath, "schema_version", ["0.1"]);
  requireScalarValue(registry, registryPath, "project", ["vibit"]);
  requireScalarValue(registry, registryPath, "status", ["draft", "active", "deprecated"]);

  const format = firstScalar(registry, "format");
  if (["yaml", "vibit_manifest_yaml"].includes(format)) {
    ok(`${registryPath} contract source format is ${format}`, {
      rule_id: "contract.registry_declared",
      artifact: registryPath,
    });
  } else {
    fail(`${registryPath} contract source format is not vibit_manifest_yaml`, {
      rule_id: "contract.registry_declared",
      artifact: registryPath,
    });
  }
  const decision = firstScalar(registry, "decision");
  if (decision === "ADR-0007") {
    ok(`${registryPath} references ADR-0007`, {
      rule_id: "contract.registry_declared",
      artifact: registryPath,
    });
  } else {
    fail(`${registryPath} does not reference ADR-0007`, {
      rule_id: "contract.registry_declared",
      artifact: registryPath,
    });
  }

  const contractTypes = [
    ["commands", "command"],
    ["queries", "query"],
    ["events", "event"],
    ["errors", "error_catalog"],
    ["permissions", "permission_catalog"],
  ];

  for (const moduleName of discoverRegisteredModules(root)) {
    const moduleInfo = loadModuleInfo(root, moduleName);
    const moduleManifestPath = `modules/${moduleName}/module.yaml`;
    const moduleManifest = isFile(root, moduleManifestPath)
      ? readText(path.join(root, moduleManifestPath))
      : "";
    const boundaryOnlyContracts = isBoundaryOnlyContractModule(registry, moduleName, moduleManifest);

    if (registry.includes(`  ${moduleName}:`)) {
      ok(`${registryPath} registers module ${moduleName}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
    } else {
      fail(`${registryPath} does not register module ${moduleName}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
      continue;
    }

    for (const [contractType, expectedKind] of contractTypes) {
      const entries = parseContractEntries(registry, moduleName, contractType);
      if (entries.length > 0) {
        ok(`${registryPath} registers ${moduleName} ${contractType}`, {
          rule_id: "contract.registry_entry",
          artifact: registryPath,
        });
      } else if (boundaryOnlyContracts) {
        ok(`${registryPath} records ${moduleName} ${contractType} as boundary-only with no public contracts yet`, {
          rule_id: "contract.boundary_only",
          artifact: registryPath,
        });
      } else {
        fail(`${registryPath} has no ${moduleName} ${contractType}`, {
          rule_id: "contract.registry_entry",
          artifact: registryPath,
        });
      }
      for (const entry of entries) {
        checkContractSource(root, moduleName, contractType, expectedKind, entry, moduleInfo, moduleManifest);
      }
    }
  }

  checkRuntimeSessionValidationContracts(root, registry, contractTypes);
  checkRuntimeAuthenticationContracts(root, registry, contractTypes);

  finish();
}

