        rule_id: ruleId,
        artifact: "proto/vibit/protocol/v1/envelope.proto",
      });
    }
  }

  const protoFiles = discoverFilesUnder(root, "proto")
    .filter((file) => file.endsWith(".proto"));
  const sessionProto = protoFiles.find((file) => {
    if (file === "proto/vibit/protocol/v1/envelope.proto") {
      return false;
    }
    const text = readText(path.join(root, file));
    return /\bRuntimeSession\b|\bruntime_sessions\b|\bsession_token\b/i.test(text);
  });
  if (sessionProto) {
    fail(`${sessionProto} adds session protocol shape during session repository boundary`, {
      rule_id: ruleId,
      artifact: sessionProto,
    });
