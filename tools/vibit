function isGeneratedContractShapeEntry(entry) {
  if (!["commands", "queries", "events", "errors", "permissions"].includes(entry.normalized_type)) {
    return false;
  }
  if (entry.module !== "runtime") {
    return true;
  }
  return entry.family === "authentication";
}

function generatedContractShapeRootForEntry(entry) {
  if (entry.module === "runtime" && entry.family) {
    return `runtime/internal/generated/contracts/${entry.module}/${entry.family}`;
  }
  return `runtime/internal/generated/contracts/${entry.module}`;
}

function generatedContractShapePath(entry) {
  return `${generatedContractShapeRootForEntry(entry)}/${entry.normalized_type}/${entry.id}.go`;
}

function goIdentifier(value) {
  return String(value || "")
    .replace(/[^A-Za-z0-9_]/g, "_")
    .replace(/^[^A-Za-z_]+/, "")
    || "Value";
}

function goStringSlice(values) {
  if (!values || values.length === 0) {
    return "nil";
  }
  return `[]string{${values.map((value) => JSON.stringify(value)).join(", ")}}`;
}

function goPackagePart(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9_]/g, "")
    .replace(/^[^a-z]+/, "")
    || "value";
}

function contractShapePackageName(entry) {
  if (entry.module === "runtime" && entry.family) {
    return `runtime${goPackagePart(entry.family)}contracts`;
  }
  return `${entry.module}contracts`;
}

function generatedContractTrace(entry) {
  if (entry.module === "runtime" && entry.family) {
    return `${entry.module}:${entry.family}:${entry.type}:${entry.id}`;
  }
  return `${entry.module}:${entry.type}:${entry.id}`;
}

function renderContractShape(root, entry) {
  const sourceText = entry.path && isFile(root, entry.path) ? readText(path.join(root, entry.path)) : "";
  const packageName = contractShapePackageName(entry);
  const variableName = `${goIdentifier(entry.id)}Contract`;
  const typeName = `${goIdentifier(entry.id)}ContractShape`;
  const status = sourceText ? firstScalar(sourceText, "status") || "" : "";
  const summary = sourceText ? firstScalar(sourceText, "summary") || "" : "";
  const permission = sourceText ? firstScalar(sourceText, "permission") || "" : "";
  const version = sourceText ? firstScalar(sourceText, "version") || "" : "";
  const errors = entry.normalized_type === "errors"
    ? listItemFieldAfterKey(sourceText, "errors", "code")
    : listAfterKey(sourceText, "errors");
  const permissions = entry.normalized_type === "permissions"
    ? listItemFieldAfterKey(sourceText, "permissions", "id")
    : [];
  const emits = listAfterKey(sourceText, "emits");
  const invariants = listAfterKey(sourceText, "invariants");
  const generatedOutputs = listAfterPath(sourceText, ["implementation", "generated_outputs"]);
  const familyTrace = entry.module === "runtime" && entry.family
    ? `\n// Family: ${entry.family}`
    : "";

  return `// Code generated by vibit generate contract-shapes. DO NOT EDIT.
// Source: ${entry.path}
// Generator: tools/vibit generate contract-shapes
// Contract: ${generatedContractTrace(entry)}${familyTrace}

package ${packageName}

// ${typeName} is a generated, inspectable summary of a vibit semantic contract.
type ${typeName} struct {
\tModule           string
\tFamily           string
\tType             string
\tID               string
\tKind             string
\tStatus           string
\tSummary          string
\tSource           string
\tPermission       string
\tVersion          string
\tEmits            []string
\tErrors           []string
\tPermissions      []string
\tInvariants       []string
\tGeneratedOutputs []string
}

// ${variableName} traces the semantic contract source into Go without adding runtime behavior.
var ${variableName} = ${typeName}{
\tModule:           ${JSON.stringify(entry.module)},
\tFamily:           ${JSON.stringify(entry.family || "")},
\tType:             ${JSON.stringify(entry.type)},
\tID:               ${JSON.stringify(entry.id)},
\tKind:             ${JSON.stringify(entry.kind)},
\tStatus:           ${JSON.stringify(status)},
\tSummary:          ${JSON.stringify(summary)},
\tSource:           ${JSON.stringify(entry.path || "")},
\tPermission:       ${JSON.stringify(permission)},
\tVersion:          ${JSON.stringify(version)},
\tEmits:            ${goStringSlice(emits)},
\tErrors:           ${goStringSlice(errors)},
\tPermissions:      ${goStringSlice(permissions)},
\tInvariants:       ${goStringSlice(invariants)},
\tGeneratedOutputs: ${goStringSlice(generatedOutputs)},
}
`;
}

function writeGeneratedContractShape(root, entry) {
  const outputPath = generatedContractShapePath(entry);
  const target = path.join(root, outputPath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  const content = renderContractShape(root, entry);
  const existed = fs.existsSync(target);
  const previous = existed ? readText(target) : null;
  if (previous !== content) {
    fs.writeFileSync(target, content, "utf8");
  }
  return {
    path: outputPath,
    status: !existed ? "created" : previous === content ? "unchanged" : "updated",
  };
}

function checkGeneratedContractShapeOutput(root) {
  const generatedRoot = "runtime/internal/generated/contracts";
  if (isDirectory(root, generatedRoot)) {
    ok(`${generatedRoot}/ exists`, {
      rule_id: "generated.root",
      artifact: generatedRoot,
    });
  } else {
    fail(`${generatedRoot}/ is missing`, {
      rule_id: "generated.root",
      artifact: generatedRoot,
    });
    return;
  }

  const entries = discoverContractRegistryEntries(root)
    .filter((entry) => isGeneratedContractShapeEntry(entry));
  const expectedPaths = new Set(entries.map((entry) => generatedContractShapePath(entry)));

  for (const entry of entries) {
    const outputPath = generatedContractShapePath(entry);
    if (!isFile(root, outputPath)) {
      fail(`${outputPath} is missing for ${entry.module}:${entry.id}`, {
        rule_id: "generated.contract_shape",
        artifact: outputPath,
      });
      continue;
    }

    ok(`${outputPath} exists`, {
      rule_id: "generated.contract_shape",
      artifact: outputPath,
    });

    const text = readText(path.join(root, outputPath));
    for (const marker of [
      "Code generated by vibit generate contract-shapes. DO NOT EDIT.",
      `Source: ${entry.path}`,
      "Generator: tools/vibit generate contract-shapes",
      `Contract: ${generatedContractTrace(entry)}`,
    ]) {
      if (text.includes(marker)) {
        ok(`${outputPath} references ${marker}`, {
          rule_id: "generated.trace",
          artifact: outputPath,
        });
      } else {
        fail(`${outputPath} does not reference ${marker}`, {
          rule_id: "generated.trace",
          artifact: outputPath,
        });
      }
    }
    if (entry.module === "runtime" && entry.family) {
      const marker = `Family: ${entry.family}`;
      if (text.includes(marker)) {
        ok(`${outputPath} references ${marker}`, {
          rule_id: "generated.trace",
          artifact: outputPath,
        });
      } else {
        fail(`${outputPath} does not reference ${marker}`, {
          rule_id: "generated.trace",
          artifact: outputPath,
        });
      }
    }

    const expectedContent = renderContractShape(root, entry);
    const normalizedText = text.replace(/\r\n/g, "\n");
    const normalizedExpected = expectedContent.replace(/\r\n/g, "\n");
    if (normalizedText === normalizedExpected) {
      ok(`${outputPath} is reproducible from ${entry.path}`, {
        rule_id: "generated.drift",
        artifact: outputPath,
      });
    } else {
      fail(`${outputPath} differs from generated output for ${entry.path}`, {
        rule_id: "generated.drift",
        artifact: outputPath,
      });
    }
  }

  const files = discoverFilesUnder(root, generatedRoot)
    .filter((file) => path.basename(file) !== ".gitkeep");
  for (const file of files) {
    if (!file.endsWith(".go")) {
      fail(`${file} is not an allowed generated contract shape file`, {
        rule_id: "generated.file_shape",
        artifact: file,
      });
      continue;
    }
    const text = readText(path.join(root, file));
    if (text.includes("Code generated by vibit generate contract-shapes. DO NOT EDIT.")) {
      ok(`${file} declares vibit contract-shapes generated marker`, {
        rule_id: "generated.trace",
        artifact: file,
      });
    } else {
      fail(`${file} is missing vibit contract-shapes generated marker`, {
        rule_id: "generated.handwritten_forbidden",
        artifact: file,
      });
    }

    if (expectedPaths.has(file)) {
      ok(`${file} is registered generated contract shape output`, {
        rule_id: "generated.contract_shape",
        artifact: file,
      });
    } else {
      fail(`${file} is stale generated contract shape output with no registered semantic contract`, {
        rule_id: "generated.drift",
        artifact: file,
      });
    }
  }
}

function discoverFilesUnder(root, relativeDir) {
  const files = [];
  const baseDir = path.join(root, relativeDir);
  function walk(dir) {
    if (!fs.existsSync(dir)) {
      return;
    }
    for (const name of fs.readdirSync(dir).sort()) {
      const fullPath = path.join(dir, name);
      const stat = fs.statSync(fullPath);
      if (stat.isDirectory()) {
        walk(fullPath);
      } else {
        files.push(rel(root, fullPath));
      }
    }
  }
  walk(baseDir);
  return files;
}

function resolveProtoSourceTrace(source) {
  const cleaned = source.trim().replace(/^["']|["']$/g, "");
  if (cleaned.startsWith("proto/")) {
    return cleaned;
  }
  return `proto/${cleaned}`;
}

function checkGeneratedProtoOutput(root) {
  const generatedRoot = "runtime/internal/generated/proto";
  if (isDirectory(root, generatedRoot)) {
    ok(`${generatedRoot}/ exists`, {
      rule_id: "generated.root",
      artifact: generatedRoot,
    });
  } else {
    fail(`${generatedRoot}/ is missing`, {
      rule_id: "generated.root",
      artifact: generatedRoot,
    });
    return;
  }

  const files = discoverFilesUnder(root, generatedRoot);
  const generatedFiles = files.filter((file) => path.basename(file) !== ".gitkeep");
  if (generatedFiles.length === 0) {
    ok(`${generatedRoot}/ has no generated Protobuf files yet`, {
      rule_id: "generated.root",
      artifact: generatedRoot,
    });
  }

  for (const file of files) {
    const name = path.basename(file);
    if (name === ".gitkeep") {
      ok(`${file} is an allowed placeholder`, {
        rule_id: "generated.root",
        artifact: file,
      });
      continue;
    }

    if (!file.endsWith(".pb.go")) {
      fail(`${file} is not an allowed Go Protobuf generated file`, {
        rule_id: file.endsWith(".go") ? "generated.handwritten_forbidden" : "generated.file_shape",
        artifact: file,
      });
      continue;
    }

    ok(`${file} uses .pb.go generated Protobuf suffix`, {
      rule_id: "generated.file_shape",
      artifact: file,
    });

    const text = readText(path.join(root, file));
    if (/^\/\/ Code generated by protoc-gen-go\. DO NOT EDIT\.$/m.test(text)) {
      ok(`${file} declares protoc-gen-go generated marker`, {
        rule_id: "generated.trace",
        artifact: file,
      });
    } else {
      fail(`${file} is missing protoc-gen-go generated marker`, {
        rule_id: "generated.trace",
        artifact: file,
      });
    }

    const sourceMatch = text.match(/^\/\/ source:\s+(.+?\.proto)\s*$/m);
    if (!sourceMatch) {
      fail(`${file} is missing Protobuf source trace`, {
        rule_id: "generated.source_trace",
        artifact: file,
      });
      continue;
    }

    const sourcePath = resolveProtoSourceTrace(sourceMatch[1]);
    ok(`${file} declares source trace ${sourcePath}`, {
      rule_id: "generated.source_trace",
      artifact: file,
    });

    if (isFile(root, sourcePath)) {
      ok(`${file} source trace resolves to ${sourcePath}`, {
        rule_id: "generated.source_trace",
        artifact: file,
      });
    } else {
      fail(`${file} source trace does not resolve to ${sourcePath}`, {
        rule_id: "generated.source_trace",
        artifact: file,
      });
    }
  }
}

function discoverMigrationFiles(root) {
  const migrationRoot = path.join(root, "runtime", "migrations", "postgres");
  if (!fs.existsSync(migrationRoot)) {
    return [];
  }
  return fs.readdirSync(migrationRoot)
    .sort()
    .filter((name) => name !== ".gitkeep")
    .filter((name) => {
      const fullPath = path.join(migrationRoot, name);
      return fs.statSync(fullPath).isFile();
    })
    .map((name) => `runtime/migrations/postgres/${name}`);
}

function checkMigrationManifestReferences(root) {
  const requiredReferences = [
    [".arch/conventions.yaml", "migration_root: runtime/migrations/postgres"],
    [".arch/conventions.yaml", "migration_naming_pattern: 000001_create_inventory_state.sql"],
    [".arch/conventions.yaml", "first_durable_migration_source: runtime/migrations/postgres/000001_create_inventory_state.sql"],
    [".arch/runtime.yaml", "source_root: runtime/migrations/postgres"],
    [".arch/runtime.yaml", "naming_pattern: 000001_create_inventory_state.sql"],
    [".arch/runtime.yaml", "file: runtime/migrations/postgres/000001_create_inventory_state.sql"],
    ["docs/postgresql-persistence-boundary.md", "runtime/migrations/postgres/"],
    ["docs/postgresql-persistence-boundary.md", "-- +goose Up"],
