function checkRuntimeImportBoundaries(root, goFiles) {
  const importRules = [
    {
      importPath: "github.com/coder/websocket",
      allowedPrefixes: ["runtime/internal/platform/transport/ws/"],
      description: "WebSocket dependency",
    },
    {
      importPath: "github.com/jackc/pgx/v5",
      allowedPrefixes: ["runtime/internal/platform/persistence/postgres/"],
      description: "PostgreSQL dependency",
    },
    {
      importPath: "github.com/pressly/goose/v3",
      allowedPrefixes: ["runtime/internal/platform/migrations/"],
      description: "migration dependency",
    },
    {
      importPath: "google.golang.org/protobuf",
      allowedPrefixes: [
        "runtime/internal/generated/proto/",
        "runtime/internal/platform/protocol/protobuf/",
      ],
      description: "Protobuf runtime dependency",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/generated/proto",
      allowedPrefixes: [
        "runtime/internal/generated/proto/",
        "runtime/internal/platform/protocol/protobuf/",
      ],
      description: "generated Protobuf package",
    },
  ];

  for (const file of goFiles) {
    const text = readText(path.join(root, file));
    for (const rule of importRules) {
      if (!text.includes(`"${rule.importPath}`)) {
        continue;
      }
      const allowed = rule.allowedPrefixes.some((prefix) => pathStartsWith(file, prefix));
      if (allowed) {
        ok(`${file} imports ${rule.description} inside allowed boundary`, {
          rule_id: "runtime.import_boundary",
          artifact: file,
        });
      } else {
        fail(`${file} imports ${rule.description} outside allowed boundary`, {
          rule_id: "runtime.import_boundary",
          artifact: file,
        });
      }
    }
  }
}

function checkRuntimeMetadataOnlyIdentityBoundaries(root, goFiles) {
  const runtimeModuleRoot = "runtime/internal/modules/";
  const wsTransportRoot = "runtime/internal/platform/transport/ws/";
  const runtimePlayerRoot = "runtime/internal/modules/player/";
  const protoPlayerRoot = "proto/vibit/player/";
  const playerModuleManifestPath = "modules/player/module.yaml";

  const wsForbiddenImports = [
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/modules/",
      allowedImportPaths: [],
      description: "domain module package",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/modules/player",
      description: "player runtime package",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/modules/inventory",
      description: "inventory runtime package",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/generated/proto",
      description: "generated Protobuf package",
    },
    {
      importPath: "google.golang.org/protobuf",
      description: "Protobuf runtime dependency",
    },
  ];

  const domainForbiddenImports = [
    {
      importPath: "github.com/coder/websocket",
      description: "WebSocket dependency",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/platform/transport/ws",
      description: "WebSocket transport package",
    },
    {
      importPath: "github.com/iceiko/vibit/runtime/internal/generated/proto",
      description: "generated Protobuf package",
    },
    {
      importPath: "google.golang.org/protobuf",
      description: "Protobuf runtime dependency",
    },
  ];

  const authDependencyMarkers = [
    { marker: "github.com/golang-jwt/", description: "JWT dependency" },
    { marker: "github.com/coreos/go-oidc", description: "OIDC dependency" },
    { marker: "golang.org/x/oauth2", description: "OAuth dependency" },
    { marker: "golang.org/x/crypto/bcrypt", description: "password hashing dependency" },
    { marker: "golang.org/x/crypto/argon2", description: "password hashing dependency" },
  ];

  const authVocabularyPatterns = [
    { pattern: /\bauthentication provider\b/i, description: "authentication provider dependency" },
    { pattern: /\bjwt\b/i, description: "token dependency" },
    { pattern: /\boauth\b/i, description: "OAuth dependency" },
    { pattern: /\boidc\b/i, description: "OIDC dependency" },
    { pattern: /\bcredential\b/i, description: "credential dependency" },
    { pattern: /\bpassword\b/i, description: "password dependency" },
  ];

  for (const file of goFiles) {
    const text = readText(path.join(root, file));

    if (pathStartsWith(file, wsTransportRoot)) {
      for (const rule of wsForbiddenImports) {
        const forbiddenImports = importsWithPrefix(text, rule.importPath);
        const allowedImports = rule.allowedImportPaths || [];
        const violations = forbiddenImports.filter((importPath) => {
          return !allowedImports.some((allowedImport) => {
            return importPath === allowedImport || importPath.startsWith(`${allowedImport}/`);
          });
        });
        if (violations.length > 0) {
          fail(`${file} violates metadata-only identity boundary: WebSocket transport imports ${rule.description}`, {
            rule_id: "runtime.identity_boundary",
            artifact: file,
          });
        } else {
          ok(`${file} respects metadata-only identity boundary: WebSocket transport avoids ${rule.description}`, {
            rule_id: "runtime.identity_boundary",
            artifact: file,
          });
        }
      }
    }

    if (pathStartsWith(file, runtimeModuleRoot)) {
      for (const rule of domainForbiddenImports) {
        const forbiddenImports = importsWithPrefix(text, rule.importPath);
        if (forbiddenImports.length > 0) {
          fail(`${file} violates metadata-only identity boundary: domain module imports ${rule.description}`, {
            rule_id: "runtime.identity_boundary",
            artifact: file,
