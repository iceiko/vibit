function findRepoRoot(startDir) {
  let current = path.resolve(startDir);
  while (true) {
    if (
      fs.existsSync(path.join(current, "CONSTITUTION.md")) &&
      fs.existsSync(path.join(current, "AGENTS.md")) &&
      fs.existsSync(path.join(current, ".arch"))
    ) {
      return current;
    }
    const parent = path.dirname(current);
    if (parent === current) {
      return null;
    }
    current = parent;
  }
}

function rel(root, target) {
  return path.relative(root, target) || ".";
}

function exists(root, relativePath) {
  return fs.existsSync(path.join(root, relativePath));
}

function isFile(root, relativePath) {
  try {
    return fs.statSync(path.join(root, relativePath)).isFile();
  } catch (_) {
    return false;
  }
}

function isDirectory(root, relativePath) {
  try {
    return fs.statSync(path.join(root, relativePath)).isDirectory();
  } catch (_) {
    return false;
  }
}

function readText(filePath) {
  return fs.readFileSync(filePath, "utf8");
}

function printJson(value) {
  fs.writeSync(1, `${JSON.stringify(value, null, 2)}\n`);
}

function writeFileIfMissing(filePath, content) {
  if (fs.existsSync(filePath)) {
    return false;
  }
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, content, "utf8");
  return true;
}

function checkName(value, label, pattern, example) {
  if (!value || !pattern.test(value)) {
    fail(`${label} must match ${example}.`);
  }
}

function ensureName(value, label, pattern, example) {
  if (!value || !pattern.test(value)) {
    console.error(`${label} must match ${example}.`);
    process.exit(2);
  }
}

let failures = 0;
let warnings = 0;
let passes = 0;
let jsonOutput = false;
let currentCheck = null;
let currentResults = [];

function inferArtifact(message) {
  const match = message.match(/^([A-Za-z0-9_./-]+)(?:\/)?\s+(?:exists|is missing|references|parses as JSON|is invalid JSON|declares|title|contains|has section|module matches|module does not match|verification status)/);
  if (match) {
    return match[1];
  }
  if (message.startsWith("spec.yaml ")) {
    return "spec.yaml";
  }
  if (message.startsWith("module.yaml ")) {
    return "module.yaml";
  }
  return null;
}

function inferRuleId(message) {
  if (message.includes(" must match ")) {
    return "argument.format";
  }
  if (message.endsWith("/ exists") || message.includes("/ exists")) {
    return "artifact.directory_exists";
  }
  if (message.endsWith(" exists")) {
    return "artifact.file_exists";
  }
  if (message.endsWith(" is missing") || message.includes(" is missing ")) {
    return "artifact.required";
  }
  if (message.includes(" references ")) {
    return "artifact.text_includes";
  }
  if (message.includes(" parses as JSON") || message.includes(" invalid JSON:")) {
    return "schema.json_parse";
  }
  if (message.includes(" declares $schema")) {
    return "schema.declares_schema_uri";
  }
  if (message.includes(" declares $id")) {
    return "schema.declares_id";
  }
  if (message.includes(" title ")) {
    return "schema.title";
  }
  if (message.includes(" declares ")) {
    return "artifact.declares_field";
  }
  if (message.includes(" contains ")) {
    return "artifact.contains_field";
  }
  if (message.includes(" has at least ")) {
    return "artifact.minimum_count";
  }
  if (message.includes(" has section ") || message.includes(" missing section ")) {
    return "markdown.section";
  }
  if (message.includes(" heading ")) {
    return "markdown.heading";
  }
  if (message.includes(" metadata ")) {
    return "markdown.metadata";
  }
  if (message.includes(" module matches registry") || message.includes(" module does not match registry")) {
    return "module.registry_match";
  }
  if (message.includes(" change_id matches directory") || message.includes(" change_id does not match ")) {
    return "change.directory_match";
  }
  if (message.includes(" verification status ")) {
    return "change.verification_status";
  }
  if (message.includes("change_id matches requested id") || message.includes("does not declare change_id")) {
    return "change.requested_id_match";
  }
  if (message.includes("module name matches directory") || message.includes("module name does not match directory")) {
    return "module.directory_match";
  }
  if (message.startsWith("run: ")) {
    return "operator.guidance";
  }
  if (message.startsWith("created ")) {
    return "generator.created_artifact";
  }
  if (message.endsWith(" already exists")) {
    return "generator.artifact_already_exists";
  }
  return "check.message";
}

function recordResult(status, severity, message, metadata = {}) {
  currentResults.push({
    status,
    severity,
    rule_id: metadata.rule_id || inferRuleId(message),
    artifact: Object.prototype.hasOwnProperty.call(metadata, "artifact") ? metadata.artifact : inferArtifact(message),
    message,
  });
}

function ok(message, metadata = {}) {
  passes += 1;
  recordResult("passed", "info", message, metadata);
  if (!jsonOutput) {
    console.log(`OK   ${message}`);
  }
}

function warn(message, metadata = {}) {
  warnings += 1;
  recordResult("warning", "warning", message, metadata);
  if (!jsonOutput) {
    console.log(`WARN ${message}`);
  }
}

function fail(message, metadata = {}) {
  failures += 1;
  recordResult("failed", "error", message, metadata);
  if (!jsonOutput) {
    console.log(`FAIL ${message}`);
  }
}

function resetResults(checkName) {
  failures = 0;
  warnings = 0;
  passes = 0;
  currentCheck = checkName;
  currentResults = [];
}

function buildCheckResult(extra = {}) {
  return {
    schema_version: "0.1",
    kind: "check_result",
    project: "vibit",
    check: currentCheck,
    status: failures > 0 ? "failed" : "passed",
    summary: {
      passed: passes,
      warnings,
      failures,
    },
    results: currentResults,
    ...extra,
  };
}

function summarizeSubcheckResult(item) {
  if (!item) {
    return null;
  }
  const summary = {
    schema_version: item.schema_version,
    kind: item.kind,
    project: item.project,
    check: item.check,
    status: item.status,
    summary: item.summary,
  };
  if (Object.prototype.hasOwnProperty.call(item, "target")) {
    summary.target = item.target;
  }
  if (Object.prototype.hasOwnProperty.call(item, "path")) {
    summary.path = item.path;
  }
  return summary;
}

function parseCheckResultSummary(stdout, args) {
  const item = JSON.parse(stdout);
  return {
    schema_version: item.schema_version,
    kind: item.kind,
    project: item.project,
    check: item.check || args.join(" "),
    status: item.status,
    summary: item.summary,
    target: item.target,
    path: item.path,
  };
}

function finish(extra = {}) {
  if (jsonOutput) {
    printJson(buildCheckResult(extra));
    process.exit(failures > 0 ? 1 : 0);
  }
  if (failures > 0) {
    console.log(`\nResult: failed (${failures} failure${failures === 1 ? "" : "s"}, ${warnings} warning${warnings === 1 ? "" : "s"})`);
    process.exit(1);
  }
  console.log(`\nResult: passed (${warnings} warning${warnings === 1 ? "" : "s"})`);
}

function requireFiles(root, files) {
  for (const file of files) {
    if (isFile(root, file)) {
      ok(`${file} exists`);
    } else {
      fail(`${file} is missing`);
    }
  }
}

function requireDirectories(root, dirs) {
  for (const dir of dirs) {
    if (isDirectory(root, dir)) {
      ok(`${dir}/ exists`);
    } else {
      fail(`${dir}/ is missing`);
    }
  }
}

function checkTextIncludes(root, file, requiredText) {
  const filePath = path.join(root, file);
  if (!isFile(root, file)) {
    fail(`${file} is missing`);
    return;
  }
  const content = readText(filePath);
  if (content.includes(requiredText)) {
    ok(`${file} references ${requiredText}`);
  } else {
    fail(`${file} does not reference ${requiredText}`);
  }
}

function requireJsonFile(root, relativePath) {
  const filePath = path.join(root, relativePath);
  if (!isFile(root, relativePath)) {
    fail(`${relativePath} is missing`);
    return null;
  }
  try {
    const parsed = JSON.parse(readText(filePath));
    ok(`${relativePath} parses as JSON`);
    return parsed;
  } catch (error) {
    fail(`${relativePath} is invalid JSON: ${error.message}`);
    return null;
  }
}

function requireSchemaShape(root, relativePath, title) {
  const schema = requireJsonFile(root, relativePath);
  if (!schema) {
    return;
  }
  if (schema.$schema) {
    ok(`${relativePath} declares $schema`);
  } else {
    fail(`${relativePath} is missing $schema`);
  }
  if (schema.$id) {
    ok(`${relativePath} declares $id`);
  } else {
    fail(`${relativePath} is missing $id`);
  }
  if (schema.title === title) {
    ok(`${relativePath} title is ${title}`);
  } else {
    fail(`${relativePath} title does not match ${title}`);
  }
}

function requireRuleCatalog(root, relativePath, expectedCatalog, expectedRuleIds) {
  const catalog = requireJsonFile(root, relativePath);
  if (!catalog) {
    return;
  }
  if (catalog.schema_version === "0.1") {
    ok(`${relativePath} declares schema_version: 0.1`);
  } else {
    fail(`${relativePath} is missing schema_version: 0.1`);
  }
  if (catalog.catalog === expectedCatalog) {
    ok(`${relativePath} catalog is ${expectedCatalog}`);
  } else {
    fail(`${relativePath} catalog does not match ${expectedCatalog}`);
  }
  if (["draft", "active", "deprecated"].includes(catalog.status)) {
    ok(`${relativePath} status is ${catalog.status}`);
  } else {
    fail(`${relativePath} status is invalid or missing`);
  }
  if (!Array.isArray(catalog.rules)) {
    fail(`${relativePath} rules must be an array`);
    return;
  }

  const seen = new Set();
  for (const [index, rule] of catalog.rules.entries()) {
    const artifact = `${relativePath}#rules/${index}`;
    if (!rule || typeof rule !== "object") {
      fail(`${artifact} must be an object`);
      continue;
    }
    if (!rule.rule_id || !/^[a-z][a-z0-9_.-]*$/.test(rule.rule_id)) {
      fail(`${artifact} has invalid rule_id`);
      continue;
    }
    if (seen.has(rule.rule_id)) {
      fail(`${relativePath} has duplicate rule_id ${rule.rule_id}`);
    } else {
      seen.add(rule.rule_id);
      ok(`${relativePath} declares rule_id ${rule.rule_id}`);
    }
    for (const key of ["category", "default_severity", "title", "description", "agent_guidance"]) {
      if (typeof rule[key] === "string" && rule[key].length > 0) {
        ok(`${artifact} declares ${key}`);
      } else {
        fail(`${artifact} is missing ${key}`);
      }
    }
    if (!["info", "warning", "error"].includes(rule.default_severity)) {
      fail(`${artifact} default_severity is invalid`);
    }
  }

  for (const ruleId of expectedRuleIds) {
    if (seen.has(ruleId)) {
      ok(`${relativePath} covers rule_id ${ruleId}`);
    } else {
      fail(`${relativePath} is missing rule_id ${ruleId}`);
    }
  }
}

function requireScalarValue(text, file, key, allowedValues) {
  const value = firstScalar(text, key);
  if (value === null) {
    fail(`${file} is missing ${key}`);
    return null;
  }
  if (allowedValues && !allowedValues.includes(value)) {
    fail(`${file} ${key} has invalid value ${value}`);
  } else {
    ok(`${file} declares ${key}: ${value}`);
  }
  return value;
}

function requireMarkdownSections(root, relativePath, sections) {
  if (!isFile(root, relativePath)) {
    fail(`${relativePath} is missing`);
    return;
  }
  const text = readText(path.join(root, relativePath));
  for (const section of sections) {
    if (text.includes(`## ${section}`)) {
      ok(`${relativePath} has section ${section}`);
    } else {
      fail(`${relativePath} is missing section ${section}`);
    }
  }
}

function requireMarkdownHeading(root, relativePath, prefix) {
  if (!isFile(root, relativePath)) {
    fail(`${relativePath} is missing`);
    return null;
  }
  const text = readText(path.join(root, relativePath));
  const heading = firstMarkdownHeading(text);
  if (!heading) {
    fail(`${relativePath} heading is missing`);
    return null;
  }
  if (prefix && !heading.startsWith(prefix)) {
    fail(`${relativePath} heading does not start with ${prefix}`);
  } else {
    ok(`${relativePath} heading is ${heading}`);
  }
  return heading;
}

function requireMarkdownField(root, relativePath, fieldName) {
  if (!isFile(root, relativePath)) {
    fail(`${relativePath} is missing`);
    return null;
  }
  const text = readText(path.join(root, relativePath));
  const value = firstMarkdownField(text, fieldName);
  if (value) {
    ok(`${relativePath} metadata ${fieldName}: ${value}`);
  } else {
    fail(`${relativePath} metadata ${fieldName} is missing`);
  }
  return value;
}

function discoverChangeIds(root) {
  const changesDir = path.join(root, "changes");
  if (!fs.existsSync(changesDir)) {
    return [];
  }
  return fs.readdirSync(changesDir)
    .filter((name) => name !== "_template")
    .filter((name) => fs.statSync(path.join(changesDir, name)).isDirectory())
    .filter((name) => fs.existsSync(path.join(changesDir, name, "spec.yaml")))
    .map((name) => name.replace(/^\d{4}-\d{2}-\d{2}-/, ""))
    .sort();
}

function sectionBody(text, sectionName) {
  const lines = text.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `${sectionName}:`);
  if (startIndex === -1) {
    return [];
  }
  const body = [];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^[a-zA-Z0-9_]+:/.test(line)) {
      break;
    }
    body.push(line);
  }
  return body;
}

function discoverRegisteredModules(root) {
  const manifestPath = path.join(root, ".arch", "modules.yaml");
  if (!fs.existsSync(manifestPath)) {
    return [];
  }
  const body = sectionBody(readText(manifestPath), "modules");
  return body
    .map((line) => line.match(/^\s+- name:\s+([a-z][a-z0-9_]*)\s*$/))
    .filter(Boolean)
    .map((match) => match[1])
    .sort();
}

function firstScalar(text, key) {
  const match = text.match(new RegExp(`^\\s*${key}:\\s*(.+?)\\s*$`, "m"));
  if (!match) {
    return null;
  }
  return match[1].replace(/^["']|["']$/g, "");
}

function listAfterKey(text, key) {
  const lines = text.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `${key}:`);
  if (startIndex === -1) {
    return [];
  }
  const values = [];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^\S/.test(line) && !line.trim().startsWith("- ")) {
      break;
    }
    const match = line.match(/^\s+-\s+(.+?)\s*$/);
    if (match) {
      values.push(match[1].replace(/^["']|["']$/g, ""));
    }
  }
  return values;
}

function listItemFieldAfterKey(text, sectionKey, fieldKey) {
  const lines = text.split(/\r?\n/);
  const startIndex = lines.findIndex((line) => line.trim() === `${sectionKey}:`);
  if (startIndex === -1) {
    return [];
  }

  const values = [];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^\S/.test(line)) {
      break;
    }
    const match = line.match(new RegExp(`^\\s+-\\s+${fieldKey}:\\s+(.+?)\\s*$`));
    if (match) {
      values.push(match[1].replace(/^["']|["']$/g, ""));
    }
  }
  return values;
}

function objectPropertyKeysAfterPath(text, pathKeys) {
  const lines = text.split(/\r?\n/);
  let startIndex = -1;
  let currentIndent = -1;

  for (const key of pathKeys) {
    let found = false;
    for (let i = startIndex + 1; i < lines.length; i += 1) {
      const line = lines[i];
      const match = line.match(/^(\s*)([A-Za-z0-9_-]+):\s*$/);
      if (!match) {
        continue;
      }
      const indent = match[1].length;
      const name = match[2];
      if (indent <= currentIndent && startIndex !== -1) {
        break;
      }
      if (name === key) {
        startIndex = i;
        currentIndent = indent;
        found = true;
        break;
      }
    }
    if (!found) {
      return [];
    }
  }

  const keys = [];
  const propertyIndent = currentIndent + 2;
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^\S/.test(line)) {
      break;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_]+):\s*$/);
    if (!keyMatch) {
      continue;
    }
    const indent = keyMatch[1].length;
    if (indent <= currentIndent) {
      break;
    }
    if (indent === propertyIndent) {
      keys.push(keyMatch[2]);
    }
  }
  return keys;
}

function listAfterPath(text, pathKeys) {
  const lines = text.split(/\r?\n/);
  let startIndex = -1;
  let currentIndent = -1;

  for (const key of pathKeys) {
    let found = false;
    for (let i = startIndex + 1; i < lines.length; i += 1) {
      const line = lines[i];
      const match = line.match(/^(\s*)([A-Za-z0-9_-]+):\s*$/);
      if (!match) {
        continue;
      }
      const indent = match[1].length;
      const name = match[2];
      if (indent <= currentIndent && startIndex !== -1) {
        break;
      }
      if (name === key) {
        startIndex = i;
        currentIndent = indent;
        found = true;
        break;
      }
    }
    if (!found) {
      return [];
    }
  }

  const values = [];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^\S/.test(line)) {
      break;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= currentIndent) {
      break;
    }
    const itemMatch = line.match(/^\s+-\s+(.+?)\s*$/);
    if (itemMatch) {
      values.push(itemMatch[1].replace(/^["']|["']$/g, ""));
    }
  }
  return values;
}

function parseContractEntries(registry, moduleName, contractType) {
  const lines = registry.split(/\r?\n/);
  const moduleIndex = lines.findIndex((line) => line.trim() === `${moduleName}:`);
  if (moduleIndex === -1) {
    return [];
  }

  let moduleIndent = null;
  const moduleMatch = lines[moduleIndex].match(/^(\s*)/);
  moduleIndent = moduleMatch ? moduleMatch[1].length : 0;

  let typeIndex = -1;
  let typeIndent = -1;
  for (let i = moduleIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):\s*$/);
    if (!keyMatch) {
      continue;
    }
    const indent = keyMatch[1].length;
    if (indent <= moduleIndent) {
      break;
    }
    if (keyMatch[2] === contractType) {
      typeIndex = i;
      typeIndent = indent;
      break;
    }
  }

  if (typeIndex === -1) {
    return [];
  }

  const entries = [];
  let current = null;
  for (let i = typeIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^\S/.test(line)) {
      break;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= typeIndent) {
      break;
    }
    const idMatch = line.match(/^\s+- id:\s+(.+?)\s*$/);
    if (idMatch) {
      if (current) {
        entries.push(current);
      }
      current = { id: idMatch[1].replace(/^["']|["']$/g, ""), path: null };
      continue;
    }
    const pathMatch = line.match(/^\s+path:\s+(.+?)\s*$/);
    if (pathMatch && current) {
      current.path = pathMatch[1].replace(/^["']|["']$/g, "");
    }
  }
  if (current) {
    entries.push(current);
  }

  return entries;
}

function discoverProtoFiles(root) {
  const files = [];
  const protoDir = path.join(root, "proto");
  function walk(dir) {
    if (!fs.existsSync(dir)) {
      return;
    }
    for (const name of fs.readdirSync(dir).sort()) {
      const fullPath = path.join(dir, name);
      const stat = fs.statSync(fullPath);
      if (stat.isDirectory()) {
        walk(fullPath);
      } else if (/\.proto$/.test(name)) {
        files.push(rel(root, fullPath));
      }
    }
  }
  walk(protoDir);
  return files;
}

function protoPackageForModule(moduleName) {
  return `vibit.${moduleName}.v1`;
}

function protoSourcePathForModule(moduleName) {
  return `proto/vibit/${moduleName}/v1/${moduleName}.proto`;
}

function expectedProtocolMessages(contractType, contractId) {
  if (contractType === "commands") {
    return [`${contractId}Request`, `${contractId}Response`];
  }
  if (contractType === "queries") {
    return [`${contractId}Request`, `${contractId}Response`];
  }
  if (contractType === "events") {
    return [contractId];
  }
  return [];
}

function expectedProtocolMessageSpecs(contractType, contractId, entryPath) {
  if (contractType === "commands" || contractType === "queries") {
    return [
      {
        name: `${contractId}Request`,
        source_section: "input",
        source: entryPath,
      },
      {
        name: `${contractId}Response`,
