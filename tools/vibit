    "runtime/internal/generated/proto",
    "runtime/migrations/postgres",
    "proto/README.md",
    "proto/README.zh-CN.md",
    "proto/vibit/inventory/v1",
  ]) {
    if (exists(root, runtimePath)) {
      ok(`${runtimePath} exists`, {
        rule_id: "runtime.skeleton",
        artifact: runtimePath,
      });
    } else {
      fail(`${runtimePath} is missing`, {
        rule_id: "runtime.skeleton",
        artifact: runtimePath,
      });
    }
  }

  checkRuntimeProtocolAdapterBoundary(root);

  const goFiles = discoverRuntimeGoFiles(root);
  if (goFiles.length === 0) {
    ok("runtime skeleton has no Go source files yet", {
      rule_id: "runtime.skeleton",
      artifact: "runtime",
    });
    finish({
      summary_counts: {
        go_files: 0,
        test_files: 0,
      },
    });
    return;
  }

  const testFiles = discoverRuntimeTestFiles(root);
  if (testFiles.length === 0) {
    fail("no runtime test files found", {
      rule_id: "runtime.test_file",
      artifact: "runtime",
    });
    finish();
    return;
  }

  for (const testFile of testFiles) {
    ok(`${testFile} exists`, {
      rule_id: "runtime.test_file",
      artifact: testFile,
    });
  }

  const goTool = childProcess.spawnSync("go", ["version"], {
    cwd: path.join(root, "runtime"),
    encoding: "utf8",
    stdio: jsonOutput ? ["ignore", "pipe", "pipe"] : "pipe",
  });
  if (goTool.status !== 0) {
    fail("Go toolchain is unavailable", {
      rule_id: "runtime.toolchain",
      artifact: "go",
    });
    finish({
      summary_counts: {
        go_files: goFiles.length,
        test_files: testFiles.length,
      },
    });
    return;
  }

  const result = childProcess.spawnSync("go", ["test", "./..."], {
    cwd: path.join(root, "runtime"),
    encoding: "utf8",
    stdio: jsonOutput ? ["ignore", "pipe", "pipe"] : "pipe",
  });

  if (!jsonOutput) {
    if (result.stdout) {
      process.stdout.write(result.stdout);
    }
    if (result.stderr) {
      process.stderr.write(result.stderr);
    }
  }

  if (result.status === 0) {
    ok("runtime tests passed", {
      rule_id: "runtime.test_result",
      artifact: "runtime tests",
    });
  } else {
    fail("runtime tests failed", {
      rule_id: "runtime.test_result",
      artifact: "runtime tests",
    });
  }

  finish({
    summary_counts: {
      go_files: goFiles.length,
      test_files: testFiles.length,
    },
  });
}

function checkRuntimeProtocolAdapterBoundary(root) {
  const requiredReferences = [
    [".arch/runtime.yaml", "runtime_protocol_adapter_boundary: ADR-0018"],
    [".arch/runtime.yaml", "standard: docs/runtime-protocol-adapter.md"],
    [".arch/runtime.yaml", "websocket_frame"],
    [".arch/runtime.yaml", "protocol_envelope"],
    [".arch/runtime.yaml", "route_request"],
    [".arch/runtime.yaml", "application_dispatch"],
    [".arch/runtime.yaml", "domain_command_or_query_handler"],
    [".arch/runtime.yaml", "TransportFrame"],
    [".arch/runtime.yaml", "ProtocolEnvelope"],
    [".arch/runtime.yaml", "RouteRequest"],
    [".arch/runtime.yaml", "ApplicationResult"],
    [".arch/runtime.yaml", "OutboundMessage"],
    [".arch/protocol.yaml", "runtime_protocol_adapter_boundary: ADR-0018"],
    [".arch/protocol.yaml", "runtime_adapter_boundary: docs/runtime-protocol-adapter.md"],
    [".arch/protocol.yaml", "Runtime handoff follows docs/runtime-protocol-adapter.md."],
    ["AGENTS.md", "docs/runtime-protocol-adapter.md"],
    ["AGENTS.zh-CN.md", "docs/runtime-protocol-adapter.md"],
    ["runtime/AGENTS.md", "../docs/runtime-protocol-adapter.md"],
    ["runtime/AGENTS.zh-CN.md", "../docs/runtime-protocol-adapter.md"],
    ["docs/game-protocol.md", "docs/runtime-protocol-adapter.md"],
    ["docs/game-protocol.zh-CN.md", "docs/runtime-protocol-adapter.md"],
  ];

  for (const [relativePath, requiredText] of requiredReferences) {
    checkRequiredText(root, relativePath, requiredText, "runtime.boundary", requiredText);
  }

  if (!isFile(root, "docs/runtime-protocol-adapter.md")) {
    return;
  }
  const standard = readText(path.join(root, "docs/runtime-protocol-adapter.md"));
  for (const section of [
    "## 1. Purpose",
    "## 2. First Runtime Flow",
    "## 3. Layer Ownership",
    "## 4. First Handoff Types",
    "## 5. Routing Rules",
    "## 6. Error Boundaries",
    "## 7. Session And Target Boundaries",
    "## 8. Agent Rules",
    "## 9. Verification",
    "## 10. Migration Path",
  ]) {
    if (standard.includes(section)) {
      ok(`docs/runtime-protocol-adapter.md has section ${section.replace(/^##\s+/, "")}`, {
        rule_id: "runtime.boundary",
        artifact: "docs/runtime-protocol-adapter.md",
      });
    } else {
      fail(`docs/runtime-protocol-adapter.md is missing section ${section.replace(/^##\s+/, "")}`, {
        rule_id: "runtime.boundary",
        artifact: "docs/runtime-protocol-adapter.md",
      });
    }
  }
}

function changeDirectory(root, changeId) {
  const direct = path.join(root, "changes", changeId);
  if (fs.existsSync(direct)) {
    return direct;
  }
  const changesDir = path.join(root, "changes");
  if (!fs.existsSync(changesDir)) {
    return direct;
  }
  const matches = fs.readdirSync(changesDir)
    .filter((name) => name.endsWith(`-${changeId}`))
    .map((name) => path.join(changesDir, name));
  if (matches.length === 1) {
    return matches[0];
  }
  return direct;
}

function checkChange(root, changeId) {
  resetResults("check change");
  checkName(changeId, "change-id", /^[a-z0-9][a-z0-9-]*[a-z0-9]$/, "kebab-case");

  const dir = changeDirectory(root, changeId);
  if (!jsonOutput) {
    console.log(`Checking change ${changeId} at ${rel(root, dir)}\n`);
  }

  if (!fs.existsSync(dir)) {
    fail(`change directory does not exist: ${rel(root, dir)}`);
    finish({ target: changeId, path: rel(root, dir) });
    return;
  }

  for (const file of CHANGE_SPEC_REQUIRED_FILES) {
    const target = path.join(dir, file);
    if (fs.existsSync(target) && fs.statSync(target).isFile()) {
      ok(`${rel(root, target)} exists`);
    } else {
      fail(`${rel(root, target)} is missing`);
    }
  }

  const specPath = path.join(dir, "spec.yaml");
  if (fs.existsSync(specPath)) {
    const spec = readText(specPath);
    if (spec.includes(`change_id: ${changeId}`)) {
      ok("spec.yaml change_id matches requested id");
    } else if (/change_id:\s+[a-z0-9-]+/.test(spec)) {
      warn("spec.yaml has a change_id, but it does not exactly match requested id");
    } else {
      fail("spec.yaml does not declare change_id");
    }
    for (const key of ["schema_version:", "date:", "type:", "status:", "summary:", "verification:"]) {
      if (spec.includes(key)) {
        ok(`spec.yaml declares ${key}`);
      } else {
        fail(`spec.yaml is missing ${key}`);
      }
    }
  }

  finish({ target: changeId, path: rel(root, dir) });
}

function checkModule(root, moduleName) {
  resetResults("check module");
  checkName(moduleName, "module", /^[a-z][a-z0-9_]*$/, "snake_case");

  const moduleDir = path.join(root, "modules", moduleName);
  if (!jsonOutput) {
    console.log(`Checking module ${moduleName} at ${rel(root, moduleDir)}\n`);
  }

  if (!fs.existsSync(moduleDir)) {
    fail(`module directory does not exist: ${rel(root, moduleDir)}`);
    warn(`run: vibit generate module ${moduleName}`);
    finish({ target: moduleName, path: rel(root, moduleDir) });
    return;
  }

  const requiredFiles = [
    "module.yaml",
    "AGENTS.md",
    "AGENTS.zh-CN.md",
  ];
  for (const file of requiredFiles) {
    const target = path.join(moduleDir, file);
    if (fs.existsSync(target) && fs.statSync(target).isFile()) {
      ok(`${rel(root, target)} exists`);
    } else {
      fail(`${rel(root, target)} is missing`);
    }
  }

  for (const dir of ["commands", "queries", "events", "models", "repositories", "policies", "services", "tests"]) {
    const target = path.join(moduleDir, dir);
    if (fs.existsSync(target) && fs.statSync(target).isDirectory()) {
      ok(`${rel(root, target)}/ exists`);
    } else {
      fail(`${rel(root, target)}/ is missing`);
    }
  }

  const manifestPath = path.join(moduleDir, "module.yaml");
  if (fs.existsSync(manifestPath)) {
    const manifest = readText(manifestPath);
    if (manifest.includes(`module: ${moduleName}`)) {
      ok("module.yaml module name matches directory");
    } else {
      fail("module.yaml module name does not match directory");
    }
    for (const key of ["schema_version:", "category:", "status:", "summary:", "owns:", "public_api:", "events:", "dependencies:", "invariants:", "generated:", "tests:"]) {
      if (manifest.includes(key)) {
        ok(`module.yaml declares ${key}`);
      } else {
        fail(`module.yaml is missing ${key}`);
      }
    }
  }

  finish({ target: moduleName, path: rel(root, moduleDir) });
}

