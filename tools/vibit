function checkMigrations(root) {
  resetResults("check migrations");
  if (!jsonOutput) {
    console.log(`Checking PostgreSQL migrations in ${root}\n`);
  }

  const migrationRoot = "runtime/migrations/postgres";
  if (isDirectory(root, migrationRoot)) {
    ok(`${migrationRoot}/ exists`, {
      rule_id: "migration.root",
      artifact: migrationRoot,
    });
  } else {
    fail(`${migrationRoot}/ is missing`, {
      rule_id: "migration.root",
      artifact: migrationRoot,
    });
    finish({
      summary_counts: {
        migration_files: 0,
        go_migrations: 0,
      },
    });
    return;
  }

  checkMigrationManifestReferences(root);

  const files = discoverMigrationFiles(root);
  const sqlFiles = files.filter((file) => file.endsWith(".sql"));
  const goFiles = files.filter((file) => file.endsWith(".go"));

  if (sqlFiles.length > 0) {
    ok(`${migrationRoot}/ contains SQL migration sources`, {
      rule_id: "migration.root",
      artifact: migrationRoot,
    });
  } else {
    fail(`${migrationRoot}/ has no SQL migration sources`, {
      rule_id: "migration.root",
      artifact: migrationRoot,
    });
  }

  if (goFiles.length === 0) {
    ok(`${migrationRoot}/ has no Go migrations`, {
      rule_id: "migration.go_forbidden",
      artifact: migrationRoot,
    });
  } else {
    for (const file of goFiles) {
      fail(`${file} is a Go migration without an explicit change-spec allowance`, {
        rule_id: "migration.go_forbidden",
        artifact: file,
      });
    }
  }

  const expectedFirstMigration = `${migrationRoot}/000001_create_inventory_state.sql`;
  if (isFile(root, expectedFirstMigration)) {
    ok(`${expectedFirstMigration} exists`, {
      rule_id: "migration.root",
      artifact: expectedFirstMigration,
    });
  } else {
    fail(`${expectedFirstMigration} is missing`, {
      rule_id: "migration.root",
      artifact: expectedFirstMigration,
    });
  }

  for (const file of sqlFiles) {
    const name = path.basename(file);
    if (/^\d{6}_[a-z0-9_]+\.sql$/.test(name)) {
      ok(`${file} matches SQL migration naming pattern`, {
        rule_id: "migration.file_shape",
        artifact: file,
      });
    } else {
      fail(`${file} does not match SQL migration naming pattern`, {
        rule_id: "migration.file_shape",
        artifact: file,
      });
    }

    const text = readText(path.join(root, file));
    if (text.includes("-- +goose Up")) {
      ok(`${file} declares -- +goose Up`, {
        rule_id: "migration.marker",
        artifact: file,
      });
    } else {
      fail(`${file} is missing -- +goose Up`, {
        rule_id: "migration.marker",
        artifact: file,
      });
    }

    if (text.includes("-- +goose Down")) {
      ok(`${file} declares -- +goose Down`, {
        rule_id: "migration.marker",
        artifact: file,
      });
    } else {
      fail(`${file} is missing -- +goose Down`, {
        rule_id: "migration.marker",
        artifact: file,
      });
    }

    if (/^--\s*Module:\s*[a-z][a-z0-9_]*(?:\.[a-z][a-z0-9_]*)*\s*$/m.test(text)) {
      ok(`${file} declares owning module`, {
        rule_id: "migration.ownership",
        artifact: file,
      });
    } else {
      fail(`${file} is missing owning module trace`, {
        rule_id: "migration.ownership",
        artifact: file,
