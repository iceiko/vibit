  }

  checkProtoGoPackage(root, protoPath, "github.com/iceiko/vibit/runtime/internal/generated/proto/vibit/protocol/v1;protocolv1");

  for (const source of [
    ".arch/protocol.yaml",
    "docs/game-protocol.md",
