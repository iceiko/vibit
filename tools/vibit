      "runtime_authentication_implementation_boundary_defined: true",
      "runtime_authentication_implemented: false",
      "token_generation_added: false",
      "token_validation_added: false",
      "verifier_comparison_added: false",
      "login_handlers_added: false",
      "logout_execution_added: false",
      "cleanup_jobs_added: false",
      "protobuf_authentication_messages_added: false",
      "websocket_proof_carrier_implemented: false",
      "generated_authentication_shapes_added: true",
      "authentication_generated_contract_shapes_added: true",
      "authentication_dependencies_added: false",
    ],
    ".arch/contracts.yaml": [
      "runtime_authentication_implementation_boundary_defined: true",
      "runtime_authentication_implemented: false",
      "token_behavior_implemented: false",
      "runtime_lookup_added: false",
      "generated_contract_shapes_added: true",
      "authentication_generated_contract_shapes_added: true",
    ],
    "modules/authentication/module.yaml": [
      "runtime_authentication_implementation_boundary_defined: true",
      "runtime_authentication_implemented: false",
      "token_generation_added: false",
      "token_validation_added: false",
      "verifier_comparison_added: false",
      "login_handlers_added: false",
      "logout_execution_added: false",
      "cleanup_jobs_added: false",
      "protobuf_authentication_messages_added: false",
      "generated_authentication_shapes_added: true",
      "authentication_generated_contract_shapes_added: true",
      "authentication_dependencies_added: false",
    ],
  };
  for (const [file, statusMarkers] of Object.entries(statusMarkersByFile)) {
