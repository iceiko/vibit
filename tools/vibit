function checkRuntimeContractFamilyContracts(root, registry, contractTypes, config) {
  const familyName = config.family;
  const registryPath = ".arch/contracts.yaml";
  const familyBlock = runtimeContractFamilyBlock(registry, config.registryFamily);
  if (!familyBlock) {
    fail(`${registryPath} does not register runtime ${config.registryFamily} contracts`, {
      rule_id: "contract.registry_entry",
      artifact: registryPath,
    });
    return;
  }

  for (const marker of config.requiredMarkers) {
    if (familyBlock.includes(marker)) {
      ok(`${registryPath} runtime ${config.registryFamily} preserves marker ${marker}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
    } else {
      fail(`${registryPath} runtime ${config.registryFamily} is missing marker ${marker}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
    }
  }

  for (const [contractType, expectedKind] of contractTypes) {
    const entries = parseContractEntries(familyBlock, config.registryFamily, contractType);
    if (contractType === "queries" && entries.length === 0) {
      ok(`${registryPath} records no runtime ${config.registryFamily} queries`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
      continue;
    }
    if (entries.length > 0) {
      ok(`${registryPath} registers runtime ${config.registryFamily} ${contractType}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
    } else {
      fail(`${registryPath} has no runtime ${config.registryFamily} ${contractType}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
      });
      continue;
    }
    for (const entry of entries) {
      checkRuntimeContractSource(root, familyName, contractType, expectedKind, entry, config.owner, familyBlock);
    }
  }
}

