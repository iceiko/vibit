      const rawText = readText(path.join(root, file));
      const text = options.stripComments ? sourceWithoutGoComments(rawText) : rawText;
      const matches = textMatchesAny(text, patterns);
      if (matches.length === 0) {
        ok(`${file} preserves authentication/token/session boundary for ${context}`, {
          rule_id: ruleId,
