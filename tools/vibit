    fail(`${registryPath} does not register runtime ${config.registryFamily} contracts`, {
      rule_id: "contract.registry_entry",
      artifact: registryPath,
    });
    return;
  }

  for (const marker of config.requiredMarkers) {
    if (familyBlock.includes(marker)) {
      ok(`${registryPath} runtime ${config.registryFamily} preserves marker ${marker}`, {
        rule_id: "contract.registry_entry",
        artifact: registryPath,
