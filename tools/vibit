      for (const match of matches) {
        fail(`${file} crosses session repository boundary with ${match.label}`, {
          rule_id: ruleId,
          artifact: file,
        });
      }
    }
  }

  if (isFile(root, "proto/vibit/protocol/v1/envelope.proto")) {
    const envelopeText = readText(path.join(root, "proto/vibit/protocol/v1/envelope.proto"));
    const forbiddenEnvelopePatterns = [
      { pattern: /\baccess_token\b/i, label: "access_token" },
      { pattern: /\bcredential\b/i, label: "credential" },
      { pattern: /\bAuthorization\b/, label: "Authorization" },
      { pattern: /\bBearer\b/, label: "Bearer" },
      { pattern: /\bhandshake\b/i, label: "handshake" },
      { pattern: /\bruntime_sessions\b/i, label: "runtime_sessions" },
    ];
    const matches = textMatchesAny(envelopeText, forbiddenEnvelopePatterns);
    if (matches.length > 0) {
      fail(`proto/vibit/protocol/v1/envelope.proto must not add session repository or proof fields: ${matches.map((item) => item.label).join(", ")}`, {
        rule_id: ruleId,
        artifact: "proto/vibit/protocol/v1/envelope.proto",
