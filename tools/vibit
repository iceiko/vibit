    [".arch/contracts.yaml", "runtime_authentication_implementation_boundary_defined: true"],
    [".arch/contracts.yaml", "runtime_authentication_implementation_boundary_standard: docs/runtime-authentication-implementation-boundary.md"],
    [".arch/reference.yaml", "phase_2e_runtime_authentication_implementation_boundary"],
    [".arch/reference.yaml", "runtime_authentication_implementation_boundary_decision: ADR-0036"],
    ["AGENTS.md", "docs/runtime-authentication-implementation-boundary.md"],
    ["AGENTS.md", "ADR-0036"],
    ["AGENTS.md", "runtime.authentication_implementation_boundary"],
    ["AGENTS.zh-CN.md", "docs/runtime-authentication-implementation-boundary.md"],
    ["AGENTS.zh-CN.md", "ADR-0036"],
    ["AGENTS.zh-CN.md", "runtime.authentication_implementation_boundary"],
    ["runtime/AGENTS.md", "../docs/runtime-authentication-implementation-boundary.md"],
    ["runtime/AGENTS.md", "ADR-0036"],
    ["runtime/AGENTS.md", "runtime.authentication_implementation_boundary"],
    ["runtime/AGENTS.zh-CN.md", "../docs/runtime-authentication-implementation-boundary.md"],
    ["runtime/AGENTS.zh-CN.md", "ADR-0036"],
    ["runtime/AGENTS.zh-CN.md", "runtime.authentication_implementation_boundary"],
