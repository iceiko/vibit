        artifact: runtimePath,
      });
    } else {
      fail(`${runtimePath} is missing`, {
        rule_id: "runtime.skeleton",
        artifact: runtimePath,
      });
    }
  }

  checkRuntimeProtocolAdapterBoundary(root);

  const goFiles = discoverRuntimeGoFiles(root);
  if (goFiles.length === 0) {
    ok("runtime skeleton has no Go source files yet", {
      rule_id: "runtime.skeleton",
      artifact: "runtime",
    });
    finish({
      summary_counts: {
        go_files: 0,
        test_files: 0,
      },
    });
    return;
  }

  const testFiles = discoverRuntimeTestFiles(root);
  if (testFiles.length === 0) {
    fail("no runtime test files found", {
      rule_id: "runtime.test_file",
      artifact: "runtime",
    });
    finish();
    return;
  }

  for (const testFile of testFiles) {
    ok(`${testFile} exists`, {
      rule_id: "runtime.test_file",
      artifact: testFile,
    });
  }

  checkRuntimeImportBoundaries(root, goFiles);
  checkRuntimeMetadataOnlyIdentityBoundaries(root, goFiles);
  checkRuntimeAuthenticationTokenSessionBoundaries(root, goFiles);
  checkRuntimeSelectedLoginTokenBoundaries(root, goFiles);
  checkRuntimeAuthenticationImplementationBoundary(root, goFiles);
  checkRuntimeApplicationAuthenticationServiceInterfaceBoundary(root, goFiles);
  checkRuntimeTokenCredentialVerifierAlgorithmRedactionBoundary(root, goFiles);
  checkRuntimeSecretConfigurationVerifierKeyLoadingBoundary(root, goFiles);
  checkRuntimeTokenCredentialMaterialGenerationBoundary(root, goFiles);
  checkRuntimeVerifierDigestComputationComparisonBoundary(root, goFiles);
  checkRuntimeVerifierDigestHelperImplementationGate(root, goFiles);
  checkRuntimeVerifierDigestComparisonHelperGate(root, goFiles);
  checkRuntimeAuthenticationServiceImplementationReadinessGate(root, goFiles);
  checkRuntimeAuthenticationServiceBehaviorImplementationGate(root, goFiles);
  checkRuntimeDeviceCredentialLoginServiceBehaviorGate(root, goFiles);
  checkRuntimeLocalVerifierKeyConfigurationLoadingGate(root, goFiles);
  checkRuntimeEnvironmentVerifierKeyLoaderGate(root, goFiles);
  checkRuntimeTokenCredentialMaterialGenerationImplementationGate(root, goFiles);
  checkRuntimeLayerBoundaries(root, goFiles);

