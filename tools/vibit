function runtimeContractFamilyBlock(registry, familyName) {
  const lines = registry.split(/\r?\n/);
  const familyIndex = lines.findIndex((line) => line.trim() === `${familyName}:`);
  if (familyIndex === -1) {
    return "";
  }

  const familyMatch = lines[familyIndex].match(/^(\s*)/);
  const familyIndent = familyMatch ? familyMatch[1].length : 0;
  const block = [lines[familyIndex]];

  for (let i = familyIndex + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (!line.trim()) {
      block.push(line);
      continue;
    }
    const keyMatch = line.match(/^(\s*)([A-Za-z0-9_-]+):/);
    if (keyMatch && keyMatch[1].length <= familyIndent) {
      break;
    }
    block.push(line);
  }

  return block.join("\n");
}

