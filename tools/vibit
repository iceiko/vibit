      { pattern: /\bBearer\b/, label: "protocol proof carrier parsing inside service" },
      { pattern: /github\.com\/iceiko\/vibit\/runtime\/internal\/platform\/persistence\/postgres/, label: "direct PostgreSQL adapter import" },
