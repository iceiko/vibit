function checkWork(root) {
  resetResults("check work");
  if (!jsonOutput) {
    console.log(`Checking work-item continuation state in ${root}\n`);
  }

  requireFiles(root, [
    ".arch/work-items.yaml",
    "docs/workflow.md",
    "docs/workflow.zh-CN.md",
  ]);

  checkTextIncludes(root, "AGENTS.md", "node tools/vibit inspect work");
  checkTextIncludes(root, "AGENTS.zh-CN.md", "node tools/vibit inspect work");
  checkTextIncludes(root, ".arch/README.md", ".arch/work-items.yaml");
  checkTextIncludes(root, ".arch/README.zh-CN.md", ".arch/work-items.yaml");

  const state = loadWorkState(root);
  if (!state.exists) {
    finish();
    return;
  }

  if (state.schema_version === "0.1") {
    ok(".arch/work-items.yaml declares schema_version: 0.1", {
      rule_id: "work.manifest",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(".arch/work-items.yaml schema_version is invalid or missing", {
      rule_id: "work.manifest",
      artifact: ".arch/work-items.yaml",
    });
  }

  if (state.status && ["draft", "active", "deprecated"].includes(state.status)) {
    ok(`.arch/work-items.yaml status is ${state.status}`, {
      rule_id: "work.manifest",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(".arch/work-items.yaml status is invalid or missing", {
      rule_id: "work.manifest",
      artifact: ".arch/work-items.yaml",
    });
  }

  if (state.standard === "docs/workflow.md") {
    ok(".arch/work-items.yaml references docs/workflow.md", {
      rule_id: "work.workflow",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(".arch/work-items.yaml standard must be docs/workflow.md", {
      rule_id: "work.workflow",
      artifact: ".arch/work-items.yaml",
    });
  }

  const activeMilestones = state.milestones.filter((milestone) => milestone.status === "active");
  if (state.milestones.length > 0) {
    ok(".arch/work-items.yaml declares milestones", {
      rule_id: "work.milestone",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(".arch/work-items.yaml must declare at least one milestone", {
      rule_id: "work.milestone",
      artifact: ".arch/work-items.yaml",
    });
  }

  if (activeMilestones.length > 0) {
    ok(".arch/work-items.yaml has an active milestone", {
      rule_id: "work.milestone",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(".arch/work-items.yaml must have at least one active milestone", {
      rule_id: "work.milestone",
      artifact: ".arch/work-items.yaml",
    });
  }

  if (state.current.milestone) {
    ok(`current milestone ${state.current_milestone} exists`, {
      rule_id: "work.milestone",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(`current milestone ${state.current_milestone || "<missing>"} is missing`, {
      rule_id: "work.milestone",
      artifact: ".arch/work-items.yaml",
    });
  }

  const seenWorkItems = new Set();
  const validWorkStatuses = new Set(["planned", "next_ready", "active", "blocked", "completed", "paused", "superseded"]);
  for (const item of state.work_items) {
    const artifact = `.arch/work-items.yaml#${item.id || "<missing>"}`;
    if (!item.id || !/^W-\d{4}$/.test(item.id)) {
      fail(`${artifact} has invalid work item id`, {
        rule_id: "work.item",
        artifact,
      });
      continue;
    }
    if (seenWorkItems.has(item.id)) {
      fail(`${artifact} duplicates a work item id`, {
        rule_id: "work.item",
        artifact,
      });
    } else {
      seenWorkItems.add(item.id);
      ok(`${artifact} declares a valid work item id`, {
        rule_id: "work.item",
        artifact,
      });
    }

    if (item.milestone && state.indexes.milestone_ids.has(item.milestone)) {
      ok(`${artifact} references milestone ${item.milestone}`, {
        rule_id: "work.milestone",
        artifact,
      });
    } else {
      fail(`${artifact} references missing milestone ${item.milestone || "<missing>"}`, {
        rule_id: "work.milestone",
        artifact,
      });
    }

    if (validWorkStatuses.has(item.status)) {
      ok(`${artifact} status is ${item.status}`, {
        rule_id: "work.item",
        artifact,
      });
    } else {
      fail(`${artifact} status is invalid or missing`, {
        rule_id: "work.item",
        artifact,
      });
    }

    if (item.status === "completed") {
      if (item.change || item.no_change_spec_reason) {
        ok(`${artifact} records completion trace`, {
          rule_id: "work.item",
          artifact,
        });
      } else {
        fail(`${artifact} completed work item must reference a change spec or no_change_spec_reason`, {
          rule_id: "work.item",
          artifact,
        });
      }
      if (item.change) {
        const relativeChange = String(item.change).replace(/^changes\/\d{4}-\d{2}-\d{2}-/, "");
        if (loadChangeInfo(root, relativeChange).exists) {
          ok(`${artifact} references existing change ${item.change}`, {
            rule_id: "work.item",
            artifact,
          });
        } else {
          fail(`${artifact} references missing change ${item.change}`, {
            rule_id: "work.item",
            artifact,
          });
        }
      }
    }

    const dependencies = Array.isArray(item.depends_on) ? item.depends_on : [];
    for (const dependencyId of dependencies) {
      const dependency = state.indexes.items_by_id.get(dependencyId);
      if (!dependency) {
        fail(`${artifact} depends on missing work item ${dependencyId}`, {
          rule_id: "work.dependency",
          artifact,
        });
      } else if (item.status === "next_ready" && dependency.status !== "completed") {
        fail(`${artifact} is next_ready but dependency ${dependencyId} is ${dependency.status}`, {
          rule_id: "work.dependency",
          artifact,
        });
      } else {
        ok(`${artifact} dependency ${dependencyId} is declared`, {
          rule_id: "work.dependency",
          artifact,
        });
      }
    }
  }

  if (state.work_items.length > 0) {
    ok(".arch/work-items.yaml declares work items", {
      rule_id: "work.item",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    fail(".arch/work-items.yaml must declare at least one work item", {
      rule_id: "work.item",
      artifact: ".arch/work-items.yaml",
    });
  }

  if (state.current.next_ready.length > 0) {
    ok(".arch/work-items.yaml has next_ready work", {
      rule_id: "work.next_ready",
      artifact: ".arch/work-items.yaml",
    });
  } else if (state.current.blocked.length > 0) {
    ok(".arch/work-items.yaml has no next_ready work item because current work is blocked", {
      rule_id: "work.next_ready",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    warn(".arch/work-items.yaml has no next_ready work item", {
      rule_id: "work.next_ready",
      artifact: ".arch/work-items.yaml",
    });
  }

  if (state.current.next_ready.length <= 1) {
    ok(".arch/work-items.yaml has at most one next_ready work item", {
      rule_id: "work.next_ready",
      artifact: ".arch/work-items.yaml",
    });
  } else {
    warn(".arch/work-items.yaml has multiple next_ready work items", {
      rule_id: "work.next_ready",
      artifact: ".arch/work-items.yaml",
    });
  }

  finish({
    summary_counts: state.summary,
    current_milestone: state.current_milestone,
    next_ready: state.current.next_ready.map((item) => item.id),
  });
}

function checkRuntime(root) {
